#!/usr/bin/env python3
"""
smokin — an idempotent tick that dispatches a Grillin plan from disk.

    smokin doctor            probe the machine, write .smokin/doctor.json
    smokin tick              one pass: reap, gate, judge, dispatch, render
    smokin run               tick until the plan is finished or stuck
    smokin status            print the frontier
    smokin present           re-render PROGRESS.md from STATUS.json
    smokin reap [--close]    force-reap overdue tasks (--close tidies panes)
    smokin rulings           resolve and print the judgement layer
    smokin resume            clear a halt, after a human has read it
    smokin reset --run <id>  retire a run's receipts and dispatch records

THE WHOLE IDEA: there is no long-running orchestrator. Every fact the tick needs
lives in the plan directory, so compaction, Ctrl-C, an SSH drop and
`herdr server stop` are all no-ops on the plan. Grillin's principle 14 says
assume amnesia and demands progress be reconstructable from the repository
alone; until now nothing made that true for a RUNNING fleet. This is that
mechanism, and it is the only thing Smokin claims that Grillin did not already.

THE OTHER HALF — THE DELEGATION NODE. A tick that only dispatches cannot make a
judgement call, and the calls that matter most are judgements: is this receipt
trustworthy, is this worker really blocked, does this failure mean stop. So
judgement is INVOKED, not resident: when the tick reaches a decision it may not
make mechanically, it asks one judge, writes the ruling to disk with its reason,
and exits. The ruling file is the memory. See DELEGATION-NODE.md; the layer is
opt-in by the presence of `_RULINGS.toml`, and it binds once it exists.

THE FRONTIER ADVANCES ON RULINGS, NOT RECEIPTS. A receipt is a worker's claim
about itself. A verdict is the project's own gate re-run by the tick. A ruling is
a judgement by someone who did not write the work. Each is a strictly stronger
statement than the one before it, and the plan moves on the strongest one the
curator asked for.

Zero dependencies (python3 stdlib). Fail-closed.
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import smokin_rulings as R                                          # noqa: E402
# NOT anchored to line start: Grillin's own register puts several of these on
# one line — "**Blocked by:** — · **Blocks:** T2" and "**Dispatch:** inproc ·
# **Runtime:** `demo`". An anchored pattern silently reads only the first field
# on each line and defaults the rest, which is how a task with a declared
# runtime dispatched as "no-headless-mode".
RE_FIELD = lambda n: re.compile(rf"\*\*{n}:\*\*\s*([^·\n]*?)(?=\*\*|·|$)", re.M | re.I)
RE_STATUS = RE_FIELD("Status")
RE_OWNER = RE_FIELD("Owner")
RE_BLOCKED = RE_FIELD("Blocked by")
RE_DISPATCH = RE_FIELD("Dispatch")
RE_RUNTIME = RE_FIELD("Runtime")
RE_BUDGET = RE_FIELD("Budget")
RE_INTERRUPT = RE_FIELD("Interrupt")
RE_WATCH = RE_FIELD("Watch")
RE_TYPE = RE_FIELD("Type")
RE_TASK_ID = re.compile(r"\b([A-Z]\d{1,3}[a-z]?)\b")
RE_FENCE = re.compile(r"```[a-z]*\n(.*?)```", re.S)

PANE_CEILING = {"XS": 0, "S": 1, "M": 3, "L": 5, "XL": 5}
DEFAULT_BUDGET = 900


# ── reading the plan ────────────────────────────────────────────────────────

def done_command(path: Path):
    """The fenced command under a '## Done means' heading. Fence-aware: a shell
    comment inside the fence looks exactly like a markdown heading."""
    body, in_section, in_fence = [], False, False
    for line in path.read_text(errors="replace").splitlines():
        if line.strip().startswith("```"):
            if in_section:
                body.append(line)
            in_fence = not in_fence
            continue
        if not in_fence and re.match(r"^#+\s", line):
            if in_section:
                break
            in_section = bool(re.match(r"^#+\s*Done\b", line, re.I))
            continue
        if in_section:
            body.append(line)
    m = RE_FENCE.search("\n".join(body) + "\n")
    if not m:
        return None
    cmd = "\n".join(l for l in m.group(1).splitlines()
                    if l.strip() and not l.strip().startswith("#")).strip()
    return cmd or None


def field(rx, text, default=""):
    m = rx.search(text)
    return m.group(1).strip() if m else default


class Task:
    def __init__(self, tid: Path):
        self.id = tid.name
        self.path = tid / "TASK.md"
        self.dir = tid
        t = self.path.read_text(errors="replace")
        self.status = field(RE_STATUS, t, "NOT STARTED").upper()
        self.owner = field(RE_OWNER, t)
        self.blocked_by = set(RE_TASK_ID.findall(field(RE_BLOCKED, t)))
        self.dispatch = (field(RE_DISPATCH, t, "inproc") or "inproc").lower()
        self.runtime = field(RE_RUNTIME, t, "claude").strip("`")
        self.type = field(RE_TYPE, t).upper()
        self.interrupt = field(RE_INTERRUPT, t, "no").lower().startswith("y")
        self.watch = field(RE_WATCH, t, "no").lower().startswith("y")
        try:
            self.budget = int(re.sub(r"\D", "", field(RE_BUDGET, t)) or DEFAULT_BUDGET)
        except ValueError:
            self.budget = DEFAULT_BUDGET
        self.done_cmd = done_command(self.path)

    def route(self):
        """§2b, first match wins. Returns (decision, clause)."""
        if self.interrupt:
            return "pane", "1 · Interrupt: yes"
        if self.watch:
            return "pane", "2 · Watch: yes"
        if self.type == "ASK":
            return "pane", "3 · Type: ASK"
        if self.budget > 900:
            return "pane", "4 · Budget > 900s"
        return "inproc", "6 · otherwise"

    def set_status(self, new):
        t = self.path.read_text(errors="replace")
        if RE_STATUS.search(t):
            t = RE_STATUS.sub(f"**Status:** {new}", t, count=1)
        else:
            t = f"**Status:** {new}\n" + t
        self.path.write_text(t)
        self.status = new


class Plan:
    def __init__(self, root: Path):
        self.root = root
        self.priv = root / ".smokin"
        self.tasks = {}
        td = root / "tasks"
        if td.is_dir():
            for d in sorted(td.iterdir()):
                if d.is_dir() and (d / "TASK.md").is_file():
                    self.tasks[d.name] = Task(d)
        # The judgement layer, read once per construction. `standing` is the
        # ruling that currently holds for each (class, task); the ledger keeps
        # every superseded one, so a re-judge leaves a trail.
        self.rules = R.load(root)
        self.standing = R.standing(self.priv)

    def size(self):
        n = len(self.tasks)
        return "XS" if n < 4 else "S" if n <= 10 else "M" if n <= 25 else "L" if n <= 60 else "XL"

    def run_id(self):
        f = self.priv / "run.json"
        if f.is_file():
            return json.loads(f.read_text())["run"]
        self.priv.mkdir(parents=True, exist_ok=True)
        rid = "r" + hashlib.sha256(f"{self.root}{time.time_ns()}".encode()).hexdigest()[:6]
        (self.priv / "run.json").write_text(json.dumps(
            {"run": rid, "started": now(), "plan_root": str(self.root)}, indent=1) + "\n")
        return rid

    def receipt(self, tid):
        p = self.root / "tasks" / tid / "RECEIPT.json"
        if not p.is_file():
            return None
        try:
            r = json.loads(p.read_text())
        except ValueError:
            return {"stale": True, "why": "unparseable"}
        for name, recorded in (r.get("artifacts") or {}).items():
            if recorded is None:
                continue
            f = self.root / "tasks" / tid / name
            if not f.is_file() or "sha256:" + hashlib.sha256(f.read_bytes()).hexdigest() != recorded:
                return {"stale": True, "why": f"{name} hash mismatch", **r}
        return r

    def verdict(self, tid):
        p = self.root / "tasks" / tid / "VERDICT.json"
        try:
            return json.loads(p.read_text())
        except (OSError, ValueError):
            return None

    def dispatch_rec(self, tid):
        try:
            return json.loads((self.priv / "dispatch" / f"{tid}.json").read_text())
        except (OSError, ValueError):
            return None

    # ── the judgement layer ─────────────────────────────────────────────────

    def ruling_ctx(self, tid):
        """The whole namespace a `when` expression may see. Built from files
        only — a `when` that could read anything else would be reading the
        orchestrator's opinion, and the orchestrator is not allowed to have one."""
        t = self.tasks[tid]
        r = self.receipt(tid) or {}
        v = self.verdict(tid) or {}
        return {
            "verdict.passed": bool(v.get("pass")), "verdict.exit": v.get("exit"),
            "receipt.claim": r.get("claim"), "receipt.terminal": r.get("terminal"),
            "receipt.source": r.get("source"), "receipt.stale": bool(r.get("stale")),
            "task.id": t.id, "task.type": t.type, "task.owner": t.owner,
            "task.runtime": t.runtime, "task.dispatch": t.route()[0],
            "state": "gated",
        }

    def rulings_needed(self, tid):
        """(required, outstanding). A required class with no standing ruling —
        or one whose evidence has changed since it was ruled on — is outstanding."""
        if not self.rules.active or self.rules.error:
            return [], []
        try:
            required = self.rules.required_for(self.ruling_ctx(tid))
        except Exception:
            # A `when` that throws is not "no ruling required". Treat it as
            # outstanding so the tick halts on it rather than sailing past.
            return ["<when raised>"], ["<when raised>"]
        out = []
        for rule in required:
            have = self.standing.get((rule["class"], tid))
            if not have:
                out.append(rule)
            elif have.get("evidence_digest") != R.evidence_digest(
                    self.root, tid, rule["evidence"]):
                out.append(rule)                      # evidence moved; re-judge
        return required, out

    def ruling_state(self, tid):
        """What the standing rulings say about a task whose gate already passed.
        Returns 'verified' | 'judging' | 'rejected' | 'escalated' | 'uncovered'."""
        if not self.rules.active or self.rules.error:
            return "verified"
        required, outstanding = self.rulings_needed(tid)
        if not required:
            return "verified" if self.rules.policy.get("uncovered") == "accept" else "uncovered"
        if outstanding:
            return "judging"
        for rule in required:
            o = (self.standing.get((rule["class"], tid)) or {}).get("outcome")
            if o in R.REJECTING:
                return "rejected"
            if o not in R.ADVANCING:
                return "escalated"          # insufficient-evidence, or anything else
        return "verified"

    # ── state ───────────────────────────────────────────────────────────────

    def state(self, tid):
        """The single source of truth for what a task IS. Order matters."""
        t = self.tasks[tid]
        v = self.verdict(tid)
        if v and v.get("pass"):
            return self.ruling_state(tid)
        if v and not v.get("pass"):
            return "refuted"
        r = self.receipt(tid)
        if r and not r.get("stale"):
            return "claimed"
        if self.dispatch_rec(tid):
            return "running"
        if t.blocked_by - {k for k in self.tasks if self.state_cheap(k) == "verified"}:
            return "blocked"
        return "ready"

    def state_cheap(self, tid):
        """Used to resolve blockers. It MUST agree with `state` on what verified
        means: a cheap check that stopped at the verdict would let dependants
        dispatch on a gate alone, which is exactly the bypass the ruling layer
        exists to close."""
        v = self.verdict(tid)
        if v and v.get("pass") and self.ruling_state(tid) == "verified":
            return "verified"
        return "other"

    def frontier(self):
        out = []
        for tid, t in self.tasks.items():
            if self.state(tid) != "ready":
                continue
            if all(self.state_cheap(b) == "verified" for b in t.blocked_by if b in self.tasks):
                out.append(tid)
        return sorted(out)


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def ledger(plan: Plan, **kw):
    kw["at"] = now()
    plan.priv.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(plan.priv / "ledger.jsonl"),
                 os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, (json.dumps(kw, ensure_ascii=False) + "\n").encode())
    finally:
        os.close(fd)


# ── dispatch ────────────────────────────────────────────────────────────────

def runtimes(plan: Plan):
    for p in (plan.priv / "runtimes.json", HERE.parent / "templates" / "runtimes.json"):
        if p.is_file():
            return json.loads(p.read_text())
    return {}


def launch(plan: Plan, t: Task, rts: dict, dry=False):
    decision, clause = t.route()
    rid = plan.run_id()
    seq = f"{rid}:{t.id}:1"
    row = rts.get(t.runtime, {})
    (plan.priv / "dispatch").mkdir(parents=True, exist_ok=True)

    line = f"read tasks/{t.id}/TASK.md and follow it"
    if len(line) > 512:
        raise SystemExit(f"dispatch line for {t.id} exceeds 512 bytes")

    env = dict(os.environ,
               SMOKIN_PLAN=str(plan.root), SMOKIN_TASK_ID=t.id,
               SMOKIN_TASK_DIR=str(t.dir), SMOKIN_EMIT=str(HERE / "smokin-emit"))

    rec = {"run": rid, "seq": seq, "task": t.id, "attempt": 1,
           "dispatch": decision, "clause": clause, "runtime": t.runtime,
           "started": now(), "started_ns": time.time_ns(),
           "started_epoch": time.time(), "budget_s": t.budget,
           "placement": None, "pid_or_pane": None}

    if dry:
        rec["dry"] = True
        (plan.priv / "dispatch" / f"{t.id}.json").write_text(json.dumps(rec, indent=1) + "\n")
        return decision, "dry-run"

    wrapper = str(HERE / "smokin-run")
    if decision == "pane":
        tmpl = row.get("pane") or f"{t.runtime} {{LINE}}"
        inner = tmpl.replace("{WT}", str(plan.root)).replace("{LINE}", line)
        pane = herdr_pane(plan, t)
        rec["placement"] = pane
        rec["pid_or_pane"] = pane and pane.get("pane")
        # the dispatch record is written BEFORE launch: that is what makes a
        # missing receipt mean something rather than being indistinguishable
        # from never-dispatched.
        (plan.priv / "dispatch" / f"{t.id}.json").write_text(json.dumps(rec, indent=1) + "\n")
        if pane:
            cmd = (f"SMOKIN_PLAN={plan.root} SMOKIN_EMIT={HERE/'smokin-emit'} "
                   f"bash {wrapper} {t.id} -- {inner}")
            sh(["herdr", "pane", "run", pane["pane"], cmd])
            return decision, pane["pane"]
        return decision, "pane-unavailable"

    head = row.get("headless")
    if not head:
        return decision, "no-headless-mode"
    (plan.priv / "dispatch" / f"{t.id}.json").write_text(json.dumps(rec, indent=1) + "\n")
    argv = ["bash", wrapper, t.id, "--"] + head.split() + [line]
    p = subprocess.Popen(argv, cwd=str(plan.root), env=env,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    rec["pid_or_pane"] = p.pid
    (plan.priv / "dispatch" / f"{t.id}.json").write_text(json.dumps(rec, indent=1) + "\n")
    return decision, f"pid {p.pid}"


def sh(argv, timeout=20):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def herdr_pane(plan: Plan, t: Task):
    """Create a pane. Optional by construction: if herdr is absent the task
    still runs, it just runs without a screen."""
    if os.environ.get("HERDR_ENV") != "1":
        return None
    r = sh(["herdr", "pane", "split", "--current", "--direction", "right",
            "--cwd", str(plan.root), "--no-focus"])
    if not r or r.returncode != 0:
        return None
    try:
        pid = json.loads(r.stdout)["result"]["pane"]["pane_id"]
    except (ValueError, KeyError):
        return None
    sh(["herdr", "pane", "rename", pid, f"smokin:{t.id}"])
    return {"pane": pid, "workspace": os.environ.get("HERDR_WORKSPACE_ID"),
            "tab": os.environ.get("HERDR_TAB_ID")}


# ── reaping and verdicts ────────────────────────────────────────────────────

def reap(plan: Plan, close_panes=False):
    """A missing receipt is a result. Runs INSIDE the tick — never a daemon,
    because a dead reaper turns a crashed worker into an orchestrator that
    waits forever, which is the failure Smokin exists to delete."""
    out = []
    d = plan.priv / "dispatch"
    if not d.is_dir():
        return out
    for f in sorted(d.glob("*.json")):
        try:
            rec = json.loads(f.read_text())
        except ValueError:
            continue
        tid = rec["task"]
        if (plan.root / "tasks" / tid / "RECEIPT.json").is_file():
            continue
        if time.time() - rec.get("started_epoch", 0) < rec.get("budget_s", DEFAULT_BUDGET):
            continue
        tr = plan.root / "tasks" / tid / ".smokin" / "transcript.log"
        tail = "\n".join(tr.read_text(errors="replace").splitlines()[-20:]) if tr.is_file() else ""
        receipt = {"schema": "smokin.receipt/1", "seq": rec["seq"], "run": rec["run"],
                   "task": tid, "attempt": rec.get("attempt", 1), "terminal": "reaped",
                   "claim": "partial", "runtime": rec.get("runtime"),
                   "dispatch": rec.get("dispatch"), "source": "reaper", "exit": None,
                   "started": rec.get("started"), "ended": now(),
                   "wall_s": round(time.time() - rec.get("started_epoch", 0), 1),
                   "result": tail, "artifacts": {}, "placement": rec.get("placement")}
        (plan.root / "tasks" / tid / "RECEIPT.json").write_text(json.dumps(receipt, indent=1) + "\n")
        if close_panes and rec.get("dispatch") == "pane" and rec.get("pid_or_pane"):
            # SIGHUP, per experiment Q2b — the worker still gets to speak.
            sh(["herdr", "pane", "close", str(rec["pid_or_pane"])])
        ledger(plan, event="reaped", task=tid, seq=rec["seq"])
        out.append(tid)
    return out


def take_verdict(plan: Plan, tid: str):
    """The tick re-runs the task's OWN done-command. A receipt is the agent's
    CLAIM; the verdict is the project's. Principle 8 one level down: a receipt
    may be a precondition of the gate, it may never BE the gate."""
    t = plan.tasks[tid]
    if not t.done_cmd:
        v = {"pass": False, "why": "no done-command", "at": now()}
    else:
        r = subprocess.run(t.done_cmd, shell=True, cwd=str(plan.root),
                           capture_output=True, text=True, timeout=120)
        blew = r.returncode in (126, 127)
        v = {"pass": r.returncode == 0 and not blew, "exit": r.returncode,
             "cmd": t.done_cmd, "at": now(),
             "why": "gate could not run (exit %d)" % r.returncode if blew else None,
             "stdout": (r.stdout or "")[-500:], "stderr": (r.stderr or "")[-500:]}
    (t.dir / "VERDICT.json").write_text(json.dumps(v, indent=1) + "\n")
    t.set_status("DONE" if v["pass"] else "BLOCKED")
    ledger(plan, event="verdict", task=tid, **{"pass": v["pass"]})
    return v


def drain_spool(plan: Plan):
    """Claim BEFORE acting. rename(inbox -> done) is the only race-free
    primitive available; acting first and moving the pointer after leaves a
    window where kill -9 re-dispatches dependants onto still-running copies."""
    spool = plan.priv / "spool"
    inbox, done = spool / "inbox", spool / "done"
    done.mkdir(parents=True, exist_ok=True)
    claimed = []
    if not inbox.is_dir():
        return claimed
    for f in sorted(inbox.glob("*.json")):
        try:
            os.rename(f, done / f.name)          # the claim
        except OSError:
            continue                             # someone else got it
        try:
            claimed.append(json.loads((done / f.name).read_text())["task"])
        except (OSError, ValueError):
            pass
    return claimed


# ── tier 3 · the halt ───────────────────────────────────────────────────────
# A halt is a RESULT. The node stops, says exactly why, and waits for a human.
# The alternative — guessing and continuing — produces a finished-looking plan
# nobody can audit, which is worse than a plan that stopped.

def halted(plan: Plan):
    try:
        return json.loads((plan.priv / "HALT.json").read_text())
    except (OSError, ValueError):
        return None


def halt(plan: Plan, why: str, tier="3", task=None):
    rec = {"schema": "smokin.halt/1", "at": now(), "tier": tier,
           "task": task, "why": why, "run": plan.run_id(),
           "clear_with": f"smokin resume {plan.root}"}
    plan.priv.mkdir(parents=True, exist_ok=True)
    (plan.priv / "HALT.json").write_text(json.dumps(rec, indent=1) + "\n")
    ledger(plan, event="halt", tier=tier, task=task, why=why)
    return rec


def print_halt(rec):
    print(f"\nHALTED — tier {rec['tier']}"
          + (f" · task {rec['task']}" if rec.get("task") else ""))
    print(f"  {rec['why']}")
    print("\nNothing further will be dispatched until a human reads this and runs")
    print(f"  {rec['clear_with']}")


# ── tier 2 · judgement, invoked and then written down ───────────────────────

def judge_pass(plan: Plan, rts: dict, dry=False):
    """Ask one judge per outstanding ruling; record every answer; return the
    first halt reason, or None.

    There is no path through this function that advances a task without a judge
    having actually answered inside its budget with an outcome from the declared
    set. Every other path halts."""
    made = []
    if not plan.rules.active:
        return made, None
    if plan.rules.error:
        return made, (f"{R.CONFIG_NAME} does not load: {plan.rules.error}. No ruling is made in "
                      f"this plan until it is fixed — falling back to 'no rulings' would let a "
                      f"typo turn the judgement layer off while still looking like it works.")

    for tid in sorted(plan.tasks):
        v = plan.verdict(tid)
        if not (v and v.get("pass")):
            continue
        required, outstanding = plan.rulings_needed(tid)
        if required and required[0] == "<when raised>":
            return made, (f"a `when` expression raised while being evaluated for {tid}. An "
                          f"expression that throws is not False; see {R.CONFIG_NAME}.")
        if not required and plan.rules.policy.get("uncovered") == "halt":
            return made, (f"{tid} passed its gate and no declared ruling class covers it. "
                          f"The node does not decide what it was not told to decide. Either add a "
                          f"[[ruling]] whose `when` matches, or write `uncovered = \"accept\"` "
                          f"under [policy] so the choice is on the record.")
        for rule in outstanding:
            if dry:
                made.append({"class": rule["class"], "task": tid, "outcome": "(dry-run)"})
                continue
            prior = plan.standing.get((rule["class"], tid))
            print(f"  judging  {tid}  {rule['class']}  "
                  f"({rule['persona']} · {rule['model']} · {rule['effort']})")
            rec, why = R.invoke_judge(plan.root, plan.priv, rule, tid, rts,
                                      attempt=(prior or {}).get("attempt", 0) + 1)
            if why:
                return made, why                       # default = halt. Not configurable.
            if prior:
                # Judge shopping leaves a trail: the superseded ruling stays in
                # the file with its reason and is named by the one that replaced it.
                rec["supersedes"] = prior.get("seq")
                rec["supersedes_outcome"] = prior.get("outcome")
            rec = R.append_ruling(plan.priv, rec)
            plan.standing[(rule["class"], tid)] = rec
            made.append(rec)
            ledger(plan, event="ruling", task=tid, cls=rule["class"],
                   outcome=rec["outcome"], persona=rule["persona"])
            if rec["outcome"] not in R.ADVANCING and rec["outcome"] not in R.REJECTING:
                return made, (f"the judge for {rule['class']} on {tid} answered "
                              f"{rec['outcome']!r}: {rec['because']} This is tier 3 — it needs a "
                              f"human, not another agent.")
    return made, None


# ── the tick ────────────────────────────────────────────────────────────────

def tick(plan: Plan, dry=False, close_panes=False):
    plan.priv.mkdir(parents=True, exist_ok=True)
    lock = open(plan.priv / "tick.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("another tick holds the lock — nothing to do")
        return 0

    held = halted(plan)
    if held:
        print_halt(held)
        return 4

    rts = runtimes(plan)
    reaped = reap(plan, close_panes)
    claimed = drain_spool(plan)

    verdicts = {}
    for tid in sorted(set(claimed) | set(reaped)):
        if tid in plan.tasks and not plan.verdict(tid):
            verdicts[tid] = take_verdict(plan, tid)

    plan.__init__(plan.root)                     # re-read: statuses changed

    rulings, why = judge_pass(plan, rts, dry=dry)
    plan.__init__(plan.root)                     # re-read: rulings changed states
    if why:
        rec = halt(plan, why, task=None)
        st = render_status(plan, reaped, list(verdicts), [], [], rulings, rec)
        write_progress(plan, st)
        for r in rulings:
            print(f"  ruling   {r.get('task')}  {r.get('class')}  {r.get('outcome')}")
        print_halt(rec)
        return 4
    for r in rulings:
        print(f"  ruling   {r.get('task')}  {r.get('class')}  {r.get('outcome')}")

    ceiling = PANE_CEILING[plan.size()]
    live_panes = sum(1 for f in (plan.priv / "dispatch").glob("*.json")
                     if json.loads(f.read_text()).get("dispatch") == "pane"
                     and not (plan.root / "tasks" /
                              json.loads(f.read_text())["task"] / "RECEIPT.json").is_file()) \
        if (plan.priv / "dispatch").is_dir() else 0

    dispatched, queued = [], []
    for tid in plan.frontier():
        t = plan.tasks[tid]
        decision, _ = t.route()
        if decision == "pane" and live_panes >= ceiling:
            queued.append((tid, "pane-ceiling"))
            continue
        d, where = launch(plan, t, rts, dry=dry)
        if where in ("no-headless-mode", "pane-unavailable"):
            # Do NOT mark it started. A task marked IN PROGRESS with no dispatch
            # record is the state that cannot be told apart from a crash, and
            # inventing it here would defeat the whole reason the dispatch
            # record is written before launch.
            queued.append((tid, where))
            ledger(plan, event="dispatch-failed", task=tid, why=where)
            continue
        if d == "pane":
            live_panes += 1
        t.set_status("IN PROGRESS")
        dispatched.append((tid, d, where))
        ledger(plan, event="dispatched", task=tid, dispatch=d, where=str(where))

    plan.__init__(plan.root)
    st = render_status(plan, reaped, list(verdicts), dispatched, queued, rulings, None)
    write_progress(plan, st)

    for tid in reaped:
        print(f"  reaped   {tid}")
    for tid, v in verdicts.items():
        print(f"  verdict  {tid}  {'PASS' if v['pass'] else 'REFUTED'}")
    for tid, d, where in dispatched:
        print(f"  dispatch {tid}  {d}  {where}")
    for tid, why in queued:
        print(f"  queued   {tid}  ({why})")

    inflight = st["counts"]["running"] + st["counts"]["claimed"] + st["counts"]["judging"]
    if st["counts"]["verified"] == len(plan.tasks) and plan.tasks:
        print(f"\nplan complete — {len(plan.tasks)}/{len(plan.tasks)} verified")
        return 0
    if inflight == 0 and not st["frontier"]:
        print("\nnothing in flight and nothing ready — the plan is STUCK")
        return 3
    print(f"\n{inflight} in flight · see PROGRESS.md")
    return 1


# ── the presenter ───────────────────────────────────────────────────────────
# Split deliberately in two. `render_status` produces STATUS.json — machine
# truth, derived only from files. `write_progress` renders PROGRESS.md and may
# read NOTHING except that object. Same rule as Grillin's reader model: the
# thing that narrates is not allowed to re-derive the facts it narrates, or it
# will eventually narrate something that is not true.

GLYPH = {"verified": "●", "judging": "◍", "claimed": "◑", "running": "◐", "ready": "○",
         "blocked": "⊘", "refuted": "✗", "rejected": "✗", "escalated": "⚑", "uncovered": "⚑"}
WORD = {"verified": "verified", "judging": "awaiting a ruling",
        "claimed": "claimed, ungated", "running": "running", "ready": "ready",
        "blocked": "blocked", "refuted": "REFUTED", "rejected": "REJECTED by a judge",
        "escalated": "ESCALATED — needs a human", "uncovered": "no ruling class covers it"}


def render_status(plan: Plan, reaped, verdicted, dispatched, queued,
                  rulings=(), halt_rec=None):
    rows, counts = [], {k: 0 for k in GLYPH}
    for tid in sorted(plan.tasks):
        t, s = plan.tasks[tid], plan.state(tid)
        counts[s] = counts.get(s, 0) + 1
        r = plan.receipt(tid) or {}
        d = plan.dispatch_rec(tid) or {}
        held = [v for (c, k), v in plan.standing.items() if k == tid]
        rows.append({
            "rulings": sorted(({"class": v.get("class"), "outcome": v.get("outcome"),
                                "persona": v.get("persona"), "model": v.get("model"),
                                "effort": v.get("effort"), "because": v.get("because"),
                                "seq": v.get("seq"),
                                "supersedes": v.get("supersedes")} for v in held),
                              key=lambda x: x["seq"] or 0),
            "id": tid, "state": s, "owner": t.owner, "runtime": t.runtime,
            "dispatch": (d.get("dispatch") or t.route()[0]),
            "clause": d.get("clause"), "where": d.get("pid_or_pane"),
            "blocked_by": sorted(t.blocked_by),
            "waiting_on": sorted(b for b in t.blocked_by
                                 if b in plan.tasks and plan.state(b) != "verified"),
            "needs_human": t.interrupt or t.type == "ASK"
                           or (plan.root / "tasks" / tid / "QUESTIONS.md").is_file(),
            "claim": r.get("claim"), "terminal": r.get("terminal"),
            "result": (r.get("result") or "").strip().splitlines()[-1:] or [""],
            "wall_s": r.get("wall_s"),
            "elapsed_s": round(time.time() - d["started_epoch"]) if d.get("started_epoch")
                         and s == "running" else None,
            "budget_s": d.get("budget_s"),
        })
    st = {"schema": "smokin.status/2", "run": plan.run_id(), "at": now(),
          "plan": str(plan.root), "size": plan.size(),
          "pane_ceiling": PANE_CEILING[plan.size()],
          "counts": counts, "total": len(plan.tasks), "tasks": rows,
          "frontier": plan.frontier(),
          "judgement": {"active": plan.rules.active, "source": plan.rules.source,
                        "error": plan.rules.error,
                        "uncovered": plan.rules.policy.get("uncovered"),
                        "classes": [r["class"] for r in plan.rules.rulings]},
          "halt": halt_rec,
          "this_tick": {"reaped": reaped, "verdicted": verdicted,
                        "dispatched": [d[0] for d in dispatched],
                        "queued": [q[0] for q in queued],
                        "ruled": [f"{r.get('task')}/{r.get('class')}={r.get('outcome')}"
                                  for r in rulings]}}
    (plan.root / "STATUS.json").write_text(json.dumps(st, indent=1) + "\n")
    return st


def bar(done, total, width=28):
    if not total:
        return "─" * width
    f = int(round(width * done / total))
    return "█" * f + "░" * (width - f)


def write_progress(plan: Plan, st: dict):
    """PROGRESS.md — the human surface. Reads only `st`."""
    L, c, tot = [], st["counts"], st["total"]
    ver = c.get("verified", 0)
    L.append("# Where the plan is")
    L.append("")
    L.append(f"`{bar(ver, tot)}`  **{ver} of {tot} verified**")
    L.append("")
    L.append(f"*run `{st['run']}` · size {st['size']} · rendered {st['at']} · "
             f"regenerated every tick — do not edit by hand*")
    L.append("")

    if st.get("halt"):
        h = st["halt"]
        L.append(f"## ⛔ HALTED — tier {h['tier']}")
        L.append("")
        L.append(f"> {h['why']}")
        L.append("")
        L.append(f"Nothing further is dispatched until a human reads this and runs "
                 f"`{h['clear_with']}`. A halt that says why is a result; a node that "
                 f"guessed and continued would not be.")
        L.append("")

    esc = [t for t in st["tasks"] if t["state"] in ("escalated", "uncovered")]
    if esc:
        L.append("## ⚑ A judge could not decide, or nothing was asked")
        L.append("")
        for t in esc:
            last = (t["rulings"] or [{}])[-1]
            L.append(f"- **{t['id']}** — {WORD[t['state']]}."
                     + (f" `{last.get('class')}` → **{last.get('outcome')}**: "
                        f"{last.get('because')}" if last.get("outcome") else ""))
        L.append("")

    rej = [t for t in st["tasks"] if t["state"] == "rejected"]
    if rej:
        L.append("## ✗ Gate passed, a judge said no")
        L.append("")
        for t in rej:
            for r in t["rulings"]:
                if r["outcome"] not in ("accept",):
                    L.append(f"- **{t['id']}** — `{r['class']}` → **{r['outcome']}** "
                             f"({r['persona']} · {r['model']} · {r['effort']}). {r['because']}")
        L.append("")
        L.append("*This is the layer the mechanical gate cannot reach: the command exited zero and "
                 "someone who did not write the work read it and disagreed.*")
        L.append("")

    need = [t for t in st["tasks"] if t["needs_human"] and t["state"] not in ("verified",)]
    if need:
        L.append("## ⏸ Waiting on you")
        L.append("")
        for t in need:
            where = f" · pane `{t['where']}`" if t["where"] else ""
            L.append(f"- **{t['id']}** — {WORD[t['state']]}{where}. "
                     f"{'Has open QUESTIONS.md.' if t['claim'] == 'blocked' else 'Declared as needing a human.'}")
        L.append("")

    ref = [t for t in st["tasks"] if t["state"] == "refuted"]
    if ref:
        L.append("## ✗ Said done, gate disagreed")
        L.append("")
        for t in ref:
            L.append(f"- **{t['id']}** — the agent claimed `{t['claim']}`, its own done-command "
                     f"exited non-zero. This is the receipt-versus-verdict split doing its job.")
        L.append("")

    L.append("## Every task")
    L.append("")
    L.append("| | Task | State | Owner | Where | Waiting on |")
    L.append("|---|---|---|---|---|---|")
    for t in st["tasks"]:
        el = ""
        if t["elapsed_s"] is not None:
            el = f" {t['elapsed_s']}s/{t['budget_s']}s"
        elif t["wall_s"]:
            el = f" {t['wall_s']}s"
        where = f"`{t['where']}`" if t["where"] else ("—" if t["state"] in ("ready", "blocked") else t["dispatch"])
        L.append(f"| {GLYPH[t['state']]} | **{t['id']}** | {WORD[t['state']]}{el} | "
                 f"{t['owner'] or '—'} | {where} | {', '.join(t['waiting_on']) or '—'} |")
    L.append("")

    tt = st["this_tick"]
    if any(tt.values()):
        L.append("## What changed this tick")
        L.append("")
        for k, label in (("dispatched", "dispatched"), ("verdicted", "gated"),
                         ("ruled", "ruled on by a judge"),
                         ("reaped", "reaped — budget expired, no receipt"),
                         ("queued", "held at the pane ceiling")):
            if tt[k]:
                L.append(f"- **{label}:** {', '.join(tt[k])}")
        L.append("")

    L.append("## Reading this")
    L.append("")
    L.append("| | Means |")
    L.append("|---|---|")
    L.append("| ● verified | gate passed **and** every ruling the plan asked for came back `accept` |")
    L.append("| ◍ awaiting a ruling | gate passed; a judge has not answered yet |")
    L.append("| ◑ claimed, ungated | the agent said it finished. Nothing has checked that yet |")
    L.append("| ◐ running | dispatched, inside its budget, no receipt |")
    L.append("| ○ ready | every blocker is verified; the next tick will dispatch it |")
    L.append("| ⊘ blocked | waiting on the tasks in the last column |")
    L.append("| ✗ REFUTED | claimed done, the mechanical gate said otherwise |")
    L.append("| ✗ REJECTED | gate passed, a judge who did not write the work said otherwise |")
    L.append("| ⚑ escalated | a judge answered *insufficient-evidence*, or nothing was asked. A human decides |")
    L.append("")
    j = st.get("judgement") or {}
    if j.get("active"):
        L.append(f"*Judgement layer: **on** — {len(j.get('classes') or [])} declared class(es) "
                 f"({', '.join(j.get('classes') or []) or '—'}), uncovered = "
                 f"`{j.get('uncovered')}`. Every ruling, including superseded ones, is in "
                 f"`.smokin/rulings.jsonl` with the reason it was made.*")
    else:
        L.append("*Judgement layer: **off** — no `_RULINGS.toml` beside the plan, so ● means the "
                 "mechanical gate and nothing more.*")
    L.append("")
    L.append("**● ◑ and ✗-by-a-judge are three different statements and the differences are the "
             "point.** A receipt is the worker's claim about itself; a verdict is the project's own "
             "gate re-run by the tick; a ruling is a judgement by someone who did not write the "
             "work. Everything here is derived from files in this directory — delete every agent "
             "and re-run `smokin tick` and the same picture comes back.")
    (plan.root / "PROGRESS.md").write_text("\n".join(L) + "\n")


# ── doctor ──────────────────────────────────────────────────────────────────

def doctor(plan: Plan):
    rts = runtimes(plan)
    out = {"at": now(), "runtimes": {}, "host": {}}
    for name, row in rts.items():
        head = (row.get("headless") or "").split()
        out["runtimes"][name] = {
            "installed": bool(head and shutil.which(head[0])),
            "path": shutil.which(head[0]) if head else None,
            "headless": bool(row.get("headless")), "pane": bool(row.get("pane"))}
    out["host"] = {
        "herdr": bool(shutil.which("herdr")), "inside_herdr": os.environ.get("HERDR_ENV") == "1",
        "python": sys.version.split()[0],
        "sh": os.path.realpath("/bin/sh"),
        "same_filesystem": None, "fs_note": None}
    try:
        a = os.stat(plan.root).st_dev
        (plan.priv).mkdir(parents=True, exist_ok=True)
        b = os.stat(plan.priv).st_dev
        out["host"]["same_filesystem"] = (a == b)
        # inotify is silent on DrvFs/9p. This is WSL: a plan under /mnt/c stops
        # delivering events, so the poll backstop is not optional there.
        out["host"]["fs_note"] = ("plan is under /mnt — inotify will not fire, polling only"
                                 if str(plan.root).startswith("/mnt/") else "native fs")
    except OSError:
        pass
    plan.priv.mkdir(parents=True, exist_ok=True)
    (plan.priv / "doctor.json").write_text(json.dumps(out, indent=1) + "\n")
    print(f"host      sh={out['host']['sh']}  herdr={'yes' if out['host']['herdr'] else 'no'}"
          f"  inside={'yes' if out['host']['inside_herdr'] else 'no'}")
    print(f"          filesystem: {out['host']['fs_note']}")
    for n, r in sorted(out["runtimes"].items()):
        mark = "ok      " if r["installed"] else "MISSING "
        print(f"runtime   {mark}{n:<12} headless={'y' if r['headless'] else 'n'} "
              f"pane={'y' if r['pane'] else 'n'}")
    missing = [n for n, r in out["runtimes"].items() if not r["installed"]]
    if missing:
        print(f"\n{len(missing)} runtime(s) declared and not installed: {', '.join(missing)}.")
        print("Learn it here, not from a gate that passed because a missing binary")
        print("exits 127 and looks like a clean failure.")
    return 0


def reset(plan: Plan, run):
    n = 0
    for p in list((plan.priv / "dispatch").glob("*.json")) if (plan.priv / "dispatch").is_dir() else []:
        p.unlink(); n += 1
    for d in ("spool/inbox", "spool/done", "spool/tmp"):
        for p in list((plan.priv / d).glob("*")) if (plan.priv / d).is_dir() else []:
            p.unlink(); n += 1
    for tid in plan.tasks:
        # The output contract goes too. A task back at NOT STARTED whose
        # FINDINGS.md is still on disk is incoherent state, and Grillin's gate
        # says so precisely: the done-command passes before any work is done,
        # so an orchestrator would mark unstarted work complete. Found by
        # running validate-plan.py against this repo's own example.
        for f in ("RECEIPT.json", "VERDICT.json", ".smokin/emit.lock",
                  "FINDINGS.md", "CHANGES.md", "QUESTIONS.md"):
            p = plan.root / "tasks" / tid / f
            if p.exists():
                p.unlink(); n += 1
        tr = plan.root / "tasks" / tid / ".smokin" / "transcript.log"
        if tr.exists():
            tr.unlink(); n += 1
        plan.tasks[tid].set_status("NOT STARTED")
    # Rulings are NOT deleted. They are retired by appending a retirement, so the
    # ruling and its reason stay readable after the run they judged is gone.
    # Deleting them would make a reset the cheapest way to erase an inconvenient
    # judgement, which is exactly the trail this design exists to leave.
    retired = 0
    for (cls, tid), rec in sorted(R.standing(plan.priv).items()):
        R.append_ruling(plan.priv, {"class": cls, "task": tid, "retired": True,
                                    "retires": rec.get("seq"), "outcome": rec.get("outcome"),
                                    "because": f"retired by `smokin reset` (was: {rec.get('because')})"})
        retired += 1
    (plan.priv / "HALT.json").unlink(missing_ok=True)
    (plan.priv / "run.json").unlink(missing_ok=True)
    print(f"reset: removed {n} artefact(s), retired {retired} ruling(s); "
          f"all tasks back to NOT STARTED")
    return 0


def show_rulings(plan: Plan):
    """A silent config is indistinguishable from a working one unless something
    can print it."""
    rs = plan.rules
    print(f"plan:   {plan.root}")
    print(f"source: {rs.source or '(none — judgement layer is OFF; ● means the gate only)'}")
    if rs.error:
        print(f"\nERROR:  {rs.error}")
        print("        No ruling is made in this plan until it is fixed. This is deliberate:")
        print("        falling back to 'no rulings' would let a typo turn the judgement")
        print("        layer off while still looking like it works.")
        return 1
    if not rs.active:
        return 0
    print(f"policy: uncovered = {rs.policy.get('uncovered')}"
          + ("   (a gate-passing task no class covers HALTS)"
             if rs.policy.get("uncovered") == "halt"
             else "   (a gate-passing task no class covers advances — on the record)"))
    rts = runtimes(plan)
    print(f"classes: {len(rs.rulings)}")
    for r in rs.rulings:
        row = rts.get(r["runtime"]) or {}
        cmd = row.get("judge") or row.get("headless") or ""
        print(f"  {r['class']}")
        print(f"      when      {r['when_src']}")
        print(f"      judge     {r['persona']} · {r['model']} · {r['effort']} "
              f"· runtime {r['runtime']} · {r['budget_s']}s")
        if not cmd:
            print(f"      WARNING   runtime {r['runtime']!r} has no headless mode. This class "
                  f"cannot be judged; the tick will halt on it.")
        else:
            missing = [w for w, ph in (("model", "{MODEL}"), ("effort", "{EFFORT}"))
                       if ph not in cmd]
            if missing:
                print(f"      NOTE      the {r['runtime']!r} command applies no "
                      f"{' or '.join(missing)} — the roster's pairing is a request here, not a "
                      f"setting. Each ruling records what was actually applied.")
        print(f"      evidence  {', '.join(r['evidence'])}")
        print(f"      outcomes  {', '.join(r['outcomes'])}   (default: {r['default']})")
    led = R.read_ledger(plan.priv)
    if led:
        print(f"\nledger: {len(led)} ruling(s) recorded in .smokin/rulings.jsonl")
        for rec in led[-8:]:
            if rec.get("retired"):
                print(f"  #{rec['seq']:<3} {rec.get('task')} {rec.get('class')} RETIRED")
                continue
            sup = f"  (supersedes #{rec['supersedes']})" if rec.get("supersedes") else ""
            print(f"  #{rec['seq']:<3} {rec.get('task')} {rec.get('class')} "
                  f"-> {rec.get('outcome')}{sup}")
            print(f"       {rec.get('because')}")
    return 0


def resume(plan: Plan):
    h = halted(plan)
    if not h:
        print("not halted — nothing to clear")
        return 0
    ledger(plan, event="resume", cleared_tier=h.get("tier"), was=h.get("why"))
    (plan.priv / "HALT.json").unlink(missing_ok=True)
    print(f"cleared a tier-{h['tier']} halt from {h['at']}:")
    print(f"  {h['why']}")
    print("\nThe halt is in .smokin/ledger.jsonl. Whatever caused it is not fixed by this.")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", choices=["doctor", "tick", "run", "status", "present",
                                    "reap", "reset", "rulings", "resume"])
    ap.add_argument("plan", nargs="?", default=".")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--close", action="store_true", help="reap also closes the pane (SIGHUP)")
    ap.add_argument("--run", default=None)
    ap.add_argument("--max-ticks", type=int, default=200)
    ap.add_argument("--interval", type=float, default=3.0)
    a = ap.parse_args()

    root = Path(a.plan).resolve()
    if not (root / "tasks").is_dir():
        print(f"smokin: {root} has no tasks/ — not a plan", file=sys.stderr)
        return 2
    plan = Plan(root)

    if a.cmd == "doctor":
        return doctor(plan)
    if a.cmd == "reset":
        return reset(plan, a.run)
    if a.cmd == "rulings":
        return show_rulings(plan)
    if a.cmd == "resume":
        return resume(plan)
    if a.cmd == "reap":
        got = reap(plan, a.close)
        print(f"reaped {len(got)}: {', '.join(got) or '—'}")
        return 0
    if a.cmd in ("status", "present"):
        st = render_status(plan, [], [], [], [], (), halted(plan))
        write_progress(plan, st)
        if a.cmd == "present":
            print((root / "PROGRESS.md").read_text())
        else:
            c = st["counts"]
            print(f"{c.get('verified',0)}/{st['total']} verified · "
                  f"frontier: {', '.join(st['frontier']) or '—'}")
        return 0
    if a.cmd == "tick":
        return tick(plan, a.dry_run, a.close)
    if a.cmd == "run":
        for i in range(a.max_ticks):
            rc = tick(plan, a.dry_run, a.close)
            if rc in (0, 3):
                return rc
            time.sleep(a.interval)
            plan = Plan(root)
        print("max ticks reached")
        return 1
    return 2


if __name__ == "__main__":
    sys.exit(main())
