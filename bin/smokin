#!/usr/bin/env python3
"""
smokin — an idempotent tick that dispatches a Grillin plan from disk.

    smokin doctor            probe the machine, write .smokin/doctor.json
    smokin verify            run every task's own done-command. Starts nothing
    smokin tick              one pass: reap, gate, judge, dispatch, render
    smokin run               tick until there is nothing a runtime may do next
    smokin wait [--task T]   block until the plan moves, or until T settles
    smokin status            print the frontier; exit 1 iff work is in flight
    smokin present           re-render PROGRESS.md from STATUS.json
    smokin reap [--close]    force-reap overdue tasks (--close closes the tabs of
                             the tasks it reaped — never of ones that finished)
    smokin rulings           resolve and print the judgement layer
    smokin memory            what each persona already observed. Read-only
    smokin remember          store one observation. Refused without its command
    smokin invariants        resolve and print the plan-level invariants
             --recapture     take a new baseline, deliberately and on the record
    smokin resume            clear a halt, after a human has read it
    smokin reset --run <id>  retire a run's receipts and dispatch records

THE WHOLE IDEA: there is no long-running orchestrator. Every fact the tick needs
lives in the plan directory, so compaction, Ctrl-C, an SSH drop and
`herdr server stop` are all no-ops on the plan. Grillin's principle 14 says
assume amnesia and demands progress be reconstructable from the repository
alone; until now nothing made that true for a RUNNING fleet. This is that
mechanism, and it is the only thing Smokin claims that Grillin did not already.

THE OTHER HALF — THE DELEGATION NODE. A tick that only dispatches cannot make a
judgement call, and the calls that matter most are judgements: is this receipt
trustworthy, is this worker really blocked, does this failure mean stop. So
judgement is INVOKED, not resident: when the tick reaches a decision it may not
make mechanically, it asks one judge, writes the ruling to disk with its reason,
and exits. The ruling file is the memory. See DELEGATION-NODE.md; the layer is
opt-in by the presence of `_RULINGS.toml`, and it binds once it exists.

THE FRONTIER ADVANCES ON RULINGS, NOT RECEIPTS. A receipt is a worker's claim
about itself. A verdict is the project's own gate re-run by the tick. A ruling is
a judgement by someone who did not write the work. Each is a strictly stronger
statement than the one before it, and the plan moves on the strongest one the
curator asked for.

AND WHAT MUST REMAIN TRUE. All three of those measure COMPLETION. None of them
measures BLAST RADIUS — what a task broke on its way to passing its own gate.
`_INVARIANTS.toml` declares readings that must not move: captured as a baseline
before the first dispatch of a run, re-checked at every tick boundary and by
`smokin verify`. A break is a halt with the command, the expected reading and
the actual one. See smokin_invariants.py for the two incidents that produced it.

AND IT RUNS UNTIL SOMEBODY HAS TO. `smokin run` ticks until the work stops being
Smokin's to do, and every way that can happen is a separate exit code, because an
operator's next action is different in each case:

    0  complete             every task verified
    1  in flight            (only from a bare `tick`; `run` keeps going)
    3  stuck                nothing running and nothing ready. Something is wrong
    4  halted               an invariant broke or a ruling said stop. Read it
    5  waiting on a person  a task is owned by a human, and everything a runtime
                            could take has been taken. Nothing is wrong

A task whose owner is a person is never dispatched — Grillin's `is_human_owned`
decides that, and this file uses Grillin's own patterns so the two cannot drift.
It is PARKED, not blocked: the tick carries on with every other ready task and
only comes to rest when the only work left belongs to somebody.

Zero dependencies (python3 stdlib). Fail-closed.
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from pathlib import Path

__version__ = "1.3.0"


def _ver():
    """Where this checkout actually is.

    Smokin installs as a git clone, so unlike Grillin's single copied file it can
    work out its own provenance — read it rather than stamp it, because a stamp
    goes stale the moment somebody pulls. Falls back to saying it does not know,
    which is more useful than a number that might be wrong.
    """
    try:
        import subprocess
        r = subprocess.run(["git", "-C", str(Path(__file__).resolve().parent.parent),
                            "describe", "--tags", "--always", "--dirty"],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    except Exception:
        pass
    return "unknown checkout"

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import smokin_rulings as R                                          # noqa: E402
import smokin_invariants as I                                       # noqa: E402
import smokin_usage as U                                            # noqa: E402
import smokin_memory as M                                           # noqa: E402
# NOT anchored to line start: Grillin's own register puts several of these on
# one line — "**Blocked by:** — · **Blocks:** T2" and "**Dispatch:** inproc ·
# **Runtime:** `demo`". An anchored pattern silently reads only the first field
# on each line and defaults the rest, which is how a task with a declared
# runtime dispatched as "no-headless-mode".
RE_FIELD = lambda n: re.compile(rf"\*\*{n}:\*\*\s*([^·\n]*?)(?=\*\*|·|$)", re.M | re.I)
RE_STATUS = RE_FIELD("Status")
RE_OWNER = RE_FIELD("Owner")
RE_BLOCKED = RE_FIELD("Blocked by")
RE_DISPATCH = RE_FIELD("Dispatch")
RE_RUNTIME = RE_FIELD("Runtime")
RE_BUDGET = RE_FIELD("Budget")
RE_INTERRUPT = RE_FIELD("Interrupt")
RE_WATCH = RE_FIELD("Watch")
RE_TYPE = RE_FIELD("Type")
# WHO the plan says is doing the work, as distinct from who is accountable for
# it. Grillin's validator says it in a comment beside its own regex: "`**Owner:**`
# is who is accountable. `**Agent:**` is the PERSONA." Smokin read `Owner` and
# never read `Agent` — CONFIRMED, `grep RE_AGENT bin/smokin` returned nothing
# before this change — and the two are not interchangeable: real `Owner` values
# in the shipped examples are `worker-a`, `reviewer`, free prose, while `Agent`
# values are `recon`, `implementer`, `adversary`, `health`, one lowercase token
# that resolves against `_ROSTER.md`.
RE_AGENT = RE_FIELD("Agent")
# adversary | health | absent. The role a task's reader plays, and the field that
# decides whether its context may be reused.
#
# GRILLIN'S REGEX, CHARACTER FOR CHARACTER, and that is the point rather than a
# convenience. This used to be a generic `RE_FIELD("Reader")` read with
# `.split()[0]`, which agreed with the gate on clean input and diverged on four
# inputs the gate accepts: `**Reader:** adversary.`, `adversary,` and
# `adversary-fresh` all classify as ADVERSARY to Grillin — which then demands
# the "not a continued session" declaration — while Smokin read `'adversary.'`,
# failed its `== "adversary"` test and handed the task a REUSED pane. Worse, the
# unanchored field takes the FIRST match anywhere in the file, so an earlier
# `**Reader:**` sharing a field line shadowed the real declaration for Smokin
# alone. The unanchored-field rationale above is about Blocked-by/Blocks and
# Dispatch/Runtime sharing a line; Reader shares a line in no fixture in either
# repository, and if it did, Grillin's gate would not see it either. Two
# programs enforcing two halves of one rule must not agree by coincidence.
RE_READER = re.compile(r"^\*\*Reader:\*\*\s*([a-z]+)", re.M | re.I)
# WHAT A PERSONA NAME MAY CONTAIN. Not a style rule — this string is a registry
# key, it names a pane a later task is sent into, and it reached a shell. Every
# `**Agent:**` in either repository's shipped plans is one lowercase token
# (`recon`, `implementer`, `adversary`, `health`); this is deliberately wider
# than that so a plan with `worker-a` or `db owner` still works, and it excludes
# every shell metacharacter. A value outside it is treated as NO PERSONA — the
# same degradation the common case already takes, since 11 of 20 shipped
# TASK.md declare no `**Agent:**` at all.
RE_AGENT_OK = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 ._-]{0,63}$")

# WHO IS A PERSON — AND THE ANSWER IS GRILLIN'S, NOT OURS. Grillin's gate already
# decides this (`is_human_owned` in scripts/validate-plan.py) because two of its
# checks pull in opposite directions on the answer: declaring `human` REMOVES the
# model floor and ADDS the frozen-contract obligation. Smokin needs the same
# answer for a third reason — a task a person owns must never be handed to a
# runtime. Three definitions would eventually disagree, and the failure mode is a
# model quietly doing a person's work while the plan reports progress. So these
# are Grillin's patterns character for character, and a contract test asserts
# that against the live file rather than trusting this comment. The same lesson
# as RE_READER, which diverged exactly this way and was caught by an adversary.
RE_OWNER_LINE = re.compile(r"^\*\*Owner\b[^:]*:\*\*\s*([^·\n]+?)\s*(?=\*\*|·|$)", re.M | re.I)
RE_AGENT_LINE = re.compile(r"^\*\*Agent\b[^:]*:\*\*\s*`?([^`·\n]+?)`?\s*(?=\*\*|·|$)", re.M | re.I)
RE_MODEL = re.compile(r"\*\*Model:\*\*\s*`?([^`·\n]+?)`?\s*(?=\*\*|·|$)", re.M | re.I)
RE_PERSONA = re.compile(r"\*\*(?:Agent|Persona):\*\*\s*`?([^`·\n]+?)`?\s*(?=\*\*|·|$)", re.M | re.I)
RE_WORKERS = re.compile(r"^\*\*Workers:\*\*\s*(.+)$", re.M | re.I)

# The ceiling on a single wait inside `run`. Not a poll interval — the waiter
# returns the instant a file moves — but the longest it may go WITHOUT ticking,
# because reaping a worker that died without emitting is something only a tick
# does and no file movement will ever announce.
MAX_WAIT_S = 30.0


def owner_of(text: str) -> str:
    """Who is accountable for this task. Empty string when nobody is named.

    Owner wins wherever it appears; Agent is a fallback only because the template
    shipped for a long time with no Owner line.
    """
    m = RE_OWNER_LINE.search(text) or RE_AGENT_LINE.search(text)
    return m.group(1).strip() if m else ""


def is_human_owned(text: str) -> bool:
    """Is this task owned by a person rather than an agent? Grillin's definition."""
    own = owner_of(text)
    if not own:
        return False
    # `human` is an EXPLICIT declaration and outranks everything, including a
    # model line. Checking the persona/model lines first suppresses the explicit
    # case — Grillin shipped that bug once and its mutation probe caught it.
    if re.search(r"\bhuman\b", own, re.I):
        return True
    # `you` and `requester` are idiom, not declaration: the shipped examples say
    # `**Owner:** you` while naming a persona and a model, and there it means
    # "you are driving this plan", not "a person executes this task".
    if RE_PERSONA.search(text) or RE_MODEL.search(text):
        return False
    return bool(re.search(r"\byou\b|\brequester\b", own, re.I))


def human_worked_plan(root) -> bool:
    """Does PLAN.md declare that the workers are people?

    The per-task test only fires on the literal words human/you/requester. Real
    plans of people write "Writer A", "the DBA" — no regex over job titles closes
    that, so the answer is declared once in PLAN.md and read, not guessed.
    """
    f = root / "PLAN.md"
    if not f.is_file():
        return False
    mw = RE_WORKERS.search(f.read_text(errors="replace"))
    return bool(mw and re.search(r"\bhumans?\b|\bpeople\b|\bpersons?\b",
                                 mw.group(1), re.I))
RE_TASK_ID = re.compile(r"\b([A-Z]\d{1,3}[a-z]?)\b")
RE_FENCE = re.compile(r"```[a-z]*\n(.*?)```", re.S)

PANE_CEILING = {"XS": 0, "S": 1, "M": 3, "L": 5, "XL": 5}
DEFAULT_BUDGET = 900


# ── reading the plan ────────────────────────────────────────────────────────

def done_command(path: Path):
    """The fenced command under a '## Done means' heading. Fence-aware: a shell
    comment inside the fence looks exactly like a markdown heading."""
    body, in_section, in_fence = [], False, False
    for line in path.read_text(errors="replace").splitlines():
        if line.strip().startswith("```"):
            if in_section:
                body.append(line)
            in_fence = not in_fence
            continue
        if not in_fence and re.match(r"^#+\s", line):
            if in_section:
                break
            in_section = bool(re.match(r"^#+\s*Done\b", line, re.I))
            continue
        if in_section:
            body.append(line)
    m = RE_FENCE.search("\n".join(body) + "\n")
    if not m:
        return None
    cmd = "\n".join(l for l in m.group(1).splitlines()
                    if l.strip() and not l.strip().startswith("#")).strip()
    return cmd or None


def field(rx, text, default=""):
    m = rx.search(text)
    return m.group(1).strip() if m else default


class Task:
    def __init__(self, tid: Path):
        self.id = tid.name
        self.path = tid / "TASK.md"
        self.dir = tid
        t = self.path.read_text(errors="replace")
        self.status = field(RE_STATUS, t, "NOT STARTED").upper()
        self.owner = field(RE_OWNER, t)
        self.blocked_by = set(RE_TASK_ID.findall(field(RE_BLOCKED, t)))
        self.dispatch = (field(RE_DISPATCH, t, "inproc") or "inproc").lower()
        self.runtime = field(RE_RUNTIME, t, "claude").strip("`")
        # THE PERSONA, AND IT DEFAULTS TO ABSENT ON PURPOSE. Re-measured across
        # every shipped TASK.md in both repositories: 9 of 20 declare it, and the
        # LARGEST fixture — `grillin/examples/a-real-first-plan`, 8 tasks —
        # declares it on none of them. So the common case is a plan that says
        # nothing here, and every mechanism downstream must degrade to doing
        # nothing rather than inventing an identity. Backticked wherever it
        # appears, exactly like **Runtime:**, hence the same strip.
        # VALIDATED, because this is the one plan-supplied string that becomes
        # a registry key AND reached a shell. The recall clause interpolates it
        # into the command the pane path hands to `herdr pane run`, unquoted:
        # `**Agent:** `impl; touch /tmp/PWNED #`` executed, CONFIRMED, and the
        # comment beside that clause asserted the opposite. Two independent
        # repairs landed — the line is shell-quoted at substitution, and a
        # persona that is not a persona name is not a persona. `agent_declared`
        # keeps the raw value so the refusal can be said out loud rather than
        # looking like a plan that declared nothing.
        self.agent_declared = field(RE_AGENT, t).strip("`").strip()
        self.agent = (self.agent_declared
                      if RE_AGENT_OK.match(self.agent_declared) else "")
        self.reader = field(RE_READER, t).strip().lower()
        # Set from this file alone. `Plan` widens it afterwards when PLAN.md
        # declares human workers — a plan-level declaration cannot be seen from
        # inside one task, and guessing at job titles is what Grillin already
        # proved does not work.
        self.human = is_human_owned(t)
        # BLOCKED ON AN ANSWER, WHICH IS NOT THE SAME AS BLOCKED ON A PERSON.
        # A worker that hits a decision it may not make writes QUESTIONS.md and
        # stops. Somebody answers by putting ANSWER.md beside it. The ANSWER file
        # existing is the whole signal — no parsing a human's edit, no marker
        # they have to remember, and the question survives verbatim next to the
        # answer for whoever reads the plan later.
        self.question = ((tid / "QUESTIONS.md").is_file()
                         and not (tid / "ANSWER.md").is_file())
        self.answered = ((tid / "QUESTIONS.md").is_file()
                         and (tid / "ANSWER.md").is_file())
        self.type = field(RE_TYPE, t).upper()
        self.interrupt = field(RE_INTERRUPT, t, "no").lower().startswith("y")
        self.watch = field(RE_WATCH, t, "no").lower().startswith("y")
        try:
            self.budget = int(re.sub(r"\D", "", field(RE_BUDGET, t)) or DEFAULT_BUDGET)
        except ValueError:
            self.budget = DEFAULT_BUDGET
        self.done_cmd = done_command(self.path)

    def route(self):
        """§2b, first match wins. Returns (decision, clause)."""
        # BEFORE EVERY OTHER CLAUSE. A person's task is not a placement question
        # — there is no runtime that can do it, and the failure this prevents is
        # not a bad pane, it is a model silently doing work a person was
        # accountable for while the plan reports it as progress.
        if self.human:
            return "human", "0 · a person owns this"
        if self.interrupt:
            return "pane", "1 · Interrupt: yes"
        if self.watch:
            return "pane", "2 · Watch: yes"
        if self.type == "ASK":
            return "pane", "3 · Type: ASK"
        if self.budget > 900:
            return "pane", "4 · Budget > 900s"
        return "inproc", "6 · otherwise"

    def set_status(self, new):
        t = self.path.read_text(errors="replace")
        if RE_STATUS.search(t):
            t = RE_STATUS.sub(f"**Status:** {new}", t, count=1)
        else:
            t = f"**Status:** {new}\n" + t
        self.path.write_text(t)
        self.status = new


class Plan:
    def __init__(self, root: Path):
        self.root = root
        self.priv = root / ".smokin"
        self.tasks = {}
        td = root / "tasks"
        if td.is_dir():
            for d in sorted(td.iterdir()):
                if d.is_dir() and (d / "TASK.md").is_file():
                    self.tasks[d.name] = Task(d)
            # THE PLAN-LEVEL DECLARATION, applied after the tasks exist because
            # it cannot be seen from inside one of them. It only ever WIDENS:
            # a task that already reads as human-owned stays so if PLAN.md says
            # nothing, and no declaration here can turn a person's task back
            # into an agent's.
            if human_worked_plan(root):
                for t in self.tasks.values():
                    t.human = True
        elif (root / "TASK.md").is_file():
            # ONE TASK, NO PLAN AROUND IT. The precondition used to be a plan
            # directory, and that precondition was the reason `verify` went
            # unused: the thing worth having at n=1 — your agent said done, was
            # it? — was gated behind first authoring a plan, at the exact moment
            # nobody wants to. A lone TASK.md is enough to re-run a
            # done-command, so it is now enough to use this.
            #
            # Read-only commands only; main() refuses to tick or dispatch one of
            # these. Running a fleet out of a directory with no plan is the
            # ceremony-free path to exactly the mess the plan directory prevents.
            self.tasks[root.name] = Task(root)
        self.single = not td.is_dir() and bool(self.tasks)
        # The judgement layer, read once per construction. `standing` is the
        # ruling that currently holds for each (class, task); the ledger keeps
        # every superseded one, so a re-judge leaves a trail.
        self.rules = R.load(root)
        self.standing = R.standing(self.priv)
        # What must REMAIN TRUE, as opposed to what each task must ACHIEVE. Opt-in
        # by the presence of `_INVARIANTS.toml`, same discipline as the rulings.
        self.invariants = I.load(root)

    def size(self):
        n = len(self.tasks)
        return "XS" if n < 4 else "S" if n <= 10 else "M" if n <= 25 else "L" if n <= 60 else "XL"

    def run_id(self):
        f = self.priv / "run.json"
        if f.is_file():
            return json.loads(f.read_text())["run"]
        self.priv.mkdir(parents=True, exist_ok=True)
        rid = "r" + hashlib.sha256(f"{self.root}{time.time_ns()}".encode()).hexdigest()[:6]
        (self.priv / "run.json").write_text(json.dumps(
            {"run": rid, "started": now(), "plan_root": str(self.root)}, indent=1) + "\n")
        return rid

    def task_dir(self, tid) -> Path:
        """Where a task's artefacts live.

        Not `root/tasks/<id>/`. That is the same path in a plan directory and a
        DIFFERENT one for a lone TASK.md, where the task folder IS the root —
        and take_verdict has always written to the task's own dir. The two
        agreed for as long as a plan was the only way in, so the coupling was
        invisible until it wasn't: verify printed PASS and then `0 of 1
        verified`, because the verdict was written to one path and counted from
        another."""
        t = self.tasks.get(tid)
        return t.dir if t else self.root / "tasks" / tid

    def receipt(self, tid):
        p = self.task_dir(tid) / "RECEIPT.json"
        if not p.is_file():
            return None
        try:
            r = json.loads(p.read_text())
        except ValueError:
            return {"stale": True, "why": "unparseable"}
        for name, recorded in (r.get("artifacts") or {}).items():
            if recorded is None:
                continue
            f = self.root / "tasks" / tid / name
            if not f.is_file() or "sha256:" + hashlib.sha256(f.read_bytes()).hexdigest() != recorded:
                return {"stale": True, "why": f"{name} hash mismatch", **r}
        return r

    def verdict(self, tid):
        p = self.task_dir(tid) / "VERDICT.json"
        try:
            return json.loads(p.read_text())
        except (OSError, ValueError):
            return None

    def dispatch_rec(self, tid):
        try:
            return json.loads((self.priv / "dispatch" / f"{tid}.json").read_text())
        except (OSError, ValueError):
            return None

    # ── the judgement layer ─────────────────────────────────────────────────

    def ruling_ctx(self, tid):
        """The whole namespace a `when` expression may see. Built from files
        only — a `when` that could read anything else would be reading the
        orchestrator's opinion, and the orchestrator is not allowed to have one."""
        t = self.tasks[tid]
        r = self.receipt(tid) or {}
        v = self.verdict(tid) or {}
        return {
            "verdict.passed": bool(v.get("pass")), "verdict.exit": v.get("exit"),
            "receipt.claim": r.get("claim"), "receipt.terminal": r.get("terminal"),
            "receipt.source": r.get("source"), "receipt.stale": bool(r.get("stale")),
            "task.id": t.id, "task.type": t.type, "task.owner": t.owner,
            "task.runtime": t.runtime, "task.dispatch": t.route()[0],
            "state": "gated",
        }

    def rulings_needed(self, tid):
        """(required, outstanding). A required class with no standing ruling —
        or one whose evidence has changed since it was ruled on — is outstanding."""
        if not self.rules.active or self.rules.error:
            return [], []
        try:
            required = self.rules.required_for(self.ruling_ctx(tid))
        except Exception:
            # A `when` that throws is not "no ruling required". Treat it as
            # outstanding so the tick halts on it rather than sailing past.
            return ["<when raised>"], ["<when raised>"]
        out = []
        for rule in required:
            have = self.standing.get((rule["class"], tid))
            if not have:
                out.append(rule)
            elif have.get("evidence_digest") != R.evidence_digest(
                    self.root, tid, rule["evidence"]):
                out.append(rule)                      # evidence moved; re-judge
        return required, out

    def ruling_state(self, tid):
        """What the standing rulings say about a task whose gate already passed.
        Returns 'verified' | 'judging' | 'rejected' | 'escalated' | 'uncovered'."""
        if not self.rules.active or self.rules.error:
            return "verified"
        required, outstanding = self.rulings_needed(tid)
        if not required:
            return "verified" if self.rules.policy.get("uncovered") == "accept" else "uncovered"
        if outstanding:
            return "judging"
        for rule in required:
            o = (self.standing.get((rule["class"], tid)) or {}).get("outcome")
            if o in R.REJECTING:
                return "rejected"
            if o not in R.ADVANCING:
                return "escalated"          # insufficient-evidence, or anything else
        return "verified"

    # ── state ───────────────────────────────────────────────────────────────

    def state(self, tid):
        """The single source of truth for what a task IS. Order matters."""
        t = self.tasks[tid]
        v = self.verdict(tid)
        if v and v.get("pass"):
            return self.ruling_state(tid)
        if v and not v.get("pass"):
            return "refuted"
        r = self.receipt(tid)
        if r and not r.get("stale"):
            return "claimed"
        if self.dispatch_rec(tid):
            return "running"
        if t.blocked_by - {k for k in self.tasks if self.state_cheap(k) == "verified"}:
            return "blocked"
        return "ready"

    def state_cheap(self, tid):
        """Used to resolve blockers. It MUST agree with `state` on what verified
        means: a cheap check that stopped at the verdict would let dependants
        dispatch on a gate alone, which is exactly the bypass the ruling layer
        exists to close."""
        v = self.verdict(tid)
        if v and v.get("pass") and self.ruling_state(tid) == "verified":
            return "verified"
        return "other"

    def frontier(self):
        out = []
        for tid, t in self.tasks.items():
            if self.state(tid) != "ready":
                continue
            if all(self.state_cheap(b) == "verified" for b in t.blocked_by if b in self.tasks):
                out.append(tid)
        return sorted(out)


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def ledger(plan: Plan, **kw):
    kw["at"] = now()
    plan.priv.mkdir(parents=True, exist_ok=True)
    fd = os.open(str(plan.priv / "ledger.jsonl"),
                 os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    try:
        os.write(fd, (json.dumps(kw, ensure_ascii=False) + "\n").encode())
    finally:
        os.close(fd)


# ── dispatch ────────────────────────────────────────────────────────────────

def runtimes(plan: Plan):
    """The capability table. Filtered to rows — the shipped template carries a
    `_comment` key whose value is a LIST, and `doctor` walked every key and
    crashed on it. It never showed up in the tests because the demo plan ships
    its own runtimes.json, so the fallback path — the one every real plan takes
    — was the one nothing exercised. Found by running doctor on a server.

    The body moved into smokin_usage the day the EMITTER needed the same table
    to know what shape a transcript is in. Two copies of a loader is two
    behaviours the first time someone adds a key to one of them; `strict` is
    the only difference the callers are allowed, and it is the difference
    between "refuse to launch" and "never refuse to write a receipt"."""
    return U.load_runtimes(
        [plan.priv / "runtimes.json", HERE.parent / "templates" / "runtimes.json"],
        strict=True)


# ── pane reuse ──────────────────────────────────────────────────────────────
# THE INCIDENT. An operator watched six agents sit idle, each holding exactly
# the context the next task needed, and opened a seventh pane. Context that cost
# real tokens to build was thrown away, and `launch()` guaranteed it would be:
# the pane branch called `herdr_pane()` unconditionally, so every pane task got a
# fresh split whether or not an agent with the right context was sitting right
# there.
#
# WHAT REUSE COSTS, WRITTEN DOWN BEFORE WHAT IT BUYS. Reuse punches a hole in
# containment. Every other mechanism in this tool assumes a task's beliefs die
# with its process — that is why `inproc` needs no containment machinery at all,
# a fresh subprocess per task gets it for free. A reused pane keeps the session
# alive across the boundary, so A WRONG BELIEF FORMED IN TASK A NOW SURVIVES
# INTO TASK B. Task B's gate cannot see it: the done-command tests B's
# artefacts, and a contaminated premise that produces a passing artefact passes.
# That is the trade, and it is the reason the decision is DEFAULT-DENY and the
# reason every answer goes in the ledger with the sentence that produced it.
#
# WHAT IT NEVER ASKS. It never asks whether a pane is alive, idle or busy.
# `grep 'os.kill|kill(0|/proc/|pid_alive|agent list|is_alive'` across all three
# executables returns nothing, that absence is deliberate (DESIGN §3j), and
# CONTRIBUTING declines "Trusting a lifecycle state" by name — on this machine
# `herdr agent list` reported two bare login shells as idle agents. So the only
# question asked of the world is an ATTEMPT: run the command on the remembered
# pane and see what came back. CONFIRMED on this machine, 2026-08-19:
# `herdr pane run w99:p99 "echo hi"` exits 1 with
# `{"error":{"code":"pane_not_found"}}`. An attempt that fails is a fact; a
# lifecycle label that says `idle` is an opinion.

REUSE_FORBIDDEN = "forbidden"
REUSE_PREFERRED = "preferred"
REUSE_PERMITTED = "permitted"


def reuse_class(t: Task):
    """What the ROLE permits, decided before any pane is looked for.

    THIS IS NOT A PREFERENCE AND MUST NOT BE READ AS ONE. Grillin's validator
    already enforces the first row — `check_adversary_context` fails a task
    declaring `**Reader:** adversary` unless it also declares
    `**Context:** fresh — not a subagent of the orchestrator, not a continued
    session` — and a reused agent IS a continued session. Reusing a pane for the
    adversarial pass would therefore make Smokin the thing that quietly breaks
    the plan's own most load-bearing check, on a task that still carries the
    declaration saying it did not. Grillin's check can only read the sentence;
    this is the half that can act on it, and it is the highest-yield check in
    the method, so getting it wrong silently is the worst outcome available.

    The second row is the same rule pointing the other way. Grillin's
    `check_health_checker` says a health reader's contamination is "required,
    not disqualifying", and deliberately does not require a clean owner for it.
    A health reader is the ONE role that gets better with the context it already
    has, so reuse is what it wants, not what it tolerates.

    Everything else is ordinary work: permitted, and bounded by the containment
    note above."""
    if t.reader == "adversary":
        return REUSE_FORBIDDEN, (
            "the adversarial pass must be a fresh context — Grillin's gate "
            "requires '**Context:** fresh — not a subagent of the orchestrator, "
            "not a continued session', and a reused agent is a continued session")
    if t.reader == "health":
        return REUSE_PREFERRED, (
            "the health reader runs in rounds and its contamination is required, "
            "not disqualifying — the context it already holds is the qualification")
    return REUSE_PERMITTED, (
        "ordinary work — reuse is allowed, and bounded by the containment cost: "
        "a wrong belief formed in the earlier task survives into this one")


def pane_history(plan: Plan, agent: str, exclude: str):
    """The pane this persona last FINISHED a task in, read from files alone.

    A persona is a label, not an addressable worker: `_ROSTER.md` prices
    `implementer` and Grillin's own shipped example puts that same label on two
    different tasks (CONFIRMED — `minimal-passing-plan` T2 and T3 both declare
    `**Agent:** `implementer``). Nothing before this turned that label into a
    thing you could send work to. A pane id does. This function is where the
    label acquires a body, and the body is a line in a dispatch record.

    NO NEW STORE. Dispatch records already survive completion — CONFIRMED, all
    three `T*.json` were still on disk after a run that finished every task, and
    only `smokin reset` unlinks them — so the persona-to-pane history is already
    fully written down and this only reads it.

    Returns (record, pending), where `pending` names the tasks this persona is
    still inside. That distinction is the difference between "there is nothing
    to reuse" and "the thing to reuse has not finished", and collapsing the two
    would put the wrong sentence in the ledger."""
    d = plan.priv / "dispatch"
    if not agent or not d.is_dir():
        return None, []
    rid = plan.run_id()
    best, pending = None, []
    for f in sorted(d.glob("*.json")):
        try:
            rec = json.loads(f.read_text())
        except (OSError, ValueError):
            continue                      # a torn record is not a pane history
        tid = rec.get("task")
        if (rec.get("dispatch") != "pane" or rec.get("agent") != agent
                or not tid or tid == exclude or not rec.get("pid_or_pane")):
            continue
        # THIS RUN ONLY, which is the rule its sibling mechanism already
        # follows and this one did not. `smokin_memory` refuses cross-run
        # recall because "the world moves between runs"; a pane held open
        # across runs carries a whole previous run's context and carries it
        # SILENTLY, which is the same claim with more of it. Two halves of one
        # feature disagreeing, with no note anywhere, was the defect.
        if rec.get("run") != rid:
            continue
        # AN ADVERSARY'S CONTEXT DOES NOT FLOW OUTWARD EITHER. `reuse_class`
        # refuses to let an adversarial task inherit a pane; nothing stopped an
        # ordinary task inheriting the ADVERSARY's, which hands the next worker
        # the fresh independent reading the plan spent a whole task buying. The
        # asymmetry was unexplained and is now closed from the same file the
        # gate reads.
        prior_t = plan.tasks.get(tid)
        if prior_t is not None and prior_t.reader == "adversary":
            continue
        # THE ONE QUESTION THE FILESYSTEM CAN ANSWER. Not "is the pane idle" —
        # that is a lifecycle belief and this design refuses to hold one. A
        # RECEIPT.json is the worker's own statement that it stopped, written
        # by its wrapper, and a task that reached a terminal state in the plan
        # is a pane whose occupant is no longer mid-sentence.
        # A RECEIPT THE WORKER WROTE, NOT ONE THE REAPER WROTE. The docstring
        # above justifies this test with "a RECEIPT.json is the worker's own
        # statement that it stopped" — and a reaped receipt is written by the
        # REAPER (`terminal: "reaped"`, `source: "reaper"`, `exit: null`)
        # precisely because the worker did NOT stop. Treating it as proof the
        # pane is free sent a second agent into a pane whose first occupant was
        # still running, and put "T1 finished in w9:p1" in the ledger while it
        # had not. A reaped task belongs in `pending`: the distinction this
        # function already draws between "nothing to reuse" and "the thing to
        # reuse has not finished" is the right one, and this falls on the
        # second side.
        r = plan.receipt(tid) or {}
        if not r or r.get("source") == "reaper" or r.get("terminal") == "reaped":
            pending.append(tid)
            continue
        if best is None or rec.get("started_ns", 0) > best.get("started_ns", 0):
            best = rec
    return best, sorted(pending)


def reuse_decision(plan: Plan, t: Task):
    """DEFAULT-DENY, decided from files only. Returns the record that goes on
    the dispatch record and into the ledger, whichever way it came out.

    Every branch below returns a `why` that names the file that decided it. A
    reuse mechanism whose declines are silent is indistinguishable from a reuse
    mechanism that was never built — and the most common case by far is a plan
    that declares no `**Agent:**` at all, so silence there would hide the
    feature from exactly the people who most need to be told it is off."""
    klass, because = reuse_class(t)
    dec = {"class": klass, "because": because, "agent": t.agent or None,
           "reader": t.reader or None, "allowed": False, "why": None,
           "pane": None, "from_task": None, "used": False, "placement": None}
    if not t.agent:
        dec["why"] = ("agent-name-rejected" if t.agent_declared
                      else "agent-not-declared")
        if t.agent_declared:
            dec["declared"] = t.agent_declared
        return dec
    if klass == REUSE_FORBIDDEN:
        dec["why"] = "reader-adversary-must-be-fresh"
        return dec
    prior, pending = pane_history(plan, t.agent, exclude=t.id)
    if prior is None:
        dec["why"] = (f"prior pane still open on {', '.join(pending)} — no receipt yet"
                      if pending else "no prior pane for this persona in this plan")
        return dec
    dec.update(allowed=True, pane=prior.get("pid_or_pane"),
               from_task=prior.get("task"), placement=prior.get("placement"),
               why=f"{prior.get('task')} finished in {prior.get('pid_or_pane')} "
                   f"and left a receipt")
    return dec


def pane_census(plan: Plan):
    """PANES OPENED PER RUN — the direct measurement of the incident.

    The incident was a pane being OPENED, so the reading is a count of panes
    opened, not of tasks dispatched, and the gap between the two is what reuse
    bought. Both numbers come off `.smokin/dispatch/*.json` and nothing else: no
    vendor state directory is read, no process is asked anything, and a cold
    reader who has never seen this run recovers the same figures from the same
    directory.

    This is deliberately NOT tokens. Token capture measures what a dispatch
    spent and only works on the headless path; reuse only happens in panes, and
    the two halves do not overlap. Measuring reuse in tokens would mean reaching
    into `~/.claude/projects`, which principle 14 and `smokin-run`:61 both
    refuse. A pane count needs no vendor parsing at all and is the thing the
    operator actually watched go wrong.

    Records written before this feature existed carry no `reuse` key and count
    as opened, which is exactly what they were."""
    out = {"dispatches": 0, "opened": 0, "reused": 0, "distinct": 0}
    d = plan.priv / "dispatch"
    if not d.is_dir():
        return out
    seen = set()
    for f in sorted(d.glob("*.json")):
        try:
            rec = json.loads(f.read_text())
        except (OSError, ValueError):
            continue
        if rec.get("dispatch") != "pane":
            continue
        out["dispatches"] += 1
        if rec.get("pid_or_pane"):
            seen.add(rec["pid_or_pane"])
        if (rec.get("reuse") or {}).get("used"):
            out["reused"] += 1
        else:
            out["opened"] += 1
    out["distinct"] = len(seen)
    return out


def launch(plan: Plan, t: Task, rts: dict, dry=False):
    decision, clause = t.route()
    rid = plan.run_id()
    seq = f"{rid}:{t.id}:1"
    row = rts.get(t.runtime, {})
    (plan.priv / "dispatch").mkdir(parents=True, exist_ok=True)

    # ── recall ──────────────────────────────────────────────────────────────
    # Decided from files, before anything is asked of the world, exactly like
    # the reuse decision below it. Scoped to THIS RUN: the archive keeps
    # everything and a human reading `smokin memory` sees all of it, but only
    # what this run observed is ever put in front of a worker (see
    # smokin_memory's docstring for why crossing a run boundary is a bigger
    # claim than this has measured).
    #
    # AND IT OBEYS THE ROLE GATE THE PANE PATH OBEYS. Recall used to consult
    # `t.agent` and nothing else, so the adversary that `reuse_class` had just
    # REFUSED a pane was handed the same persona's entries as a file — `kind:
    # lesson` included, which this store defines as "a generalisation somebody
    # drew", i.e. exactly the "merely concluded" half the containment rule says
    # must not carry forward. A gate enforced on one channel and not the other
    # is not a gate. The refusal is written with the SAME sentence the reuse
    # decision writes, because it is the same rule.
    klass, because = reuse_class(t)
    forbidden = klass == REUSE_FORBIDDEN
    entries = M.read(plan.priv) if (t.agent and not forbidden) else []
    recall = M.for_agent(entries, t.agent, run=rid) if entries else []
    rec_note = ({"recalled": 0, "why": "agent-name-rejected",
                 "declared": t.agent_declared} if t.agent_declared and not t.agent
                else {"recalled": 0, "why": "agent-not-declared"} if not t.agent
                else {"recalled": 0, "why": "reader-adversary-must-be-fresh",
                      "because": because} if forbidden
                else {"recalled": 0, "why": "nothing remembered for this persona "
                      "in this run"} if not recall
                else {"recalled": len(recall), "agent": t.agent,
                      "keys": [e.get("key") for e in recall],
                      "bytes": M.recall_bytes(recall),
                      "from_tasks": sorted({e.get("task") for e in recall}),
                      "file": f"tasks/{t.id}/MEMORY.md", "why": None})

    line = f"read tasks/{t.id}/TASK.md and follow it"
    if recall:
        # THE LINE CHANGES ONLY WHEN THERE IS SOMETHING TO SAY, which is what
        # makes "the dispatch line is byte-identical when no memory exists" an
        # exact control rather than a claim about intent. §4a says the line
        # names the task path "and nothing else"; that is amended here to
        # "names paths inside its own task folder and nothing else" — MEMORY.md
        # is written by Smokin into `tasks/<ID>/`, the same folder and the same
        # principle-14 reasoning as the transcript, and the alternative was an
        # agent that never finds the file.
        #
        # NO PLAN-SUPPLIED TEXT IN THIS CLAUSE. The comment that stood here
        # said "the clause is fixed text plus a task id" while `{t.agent}` sat
        # in the same f-string, and the pane path interpolates the result into
        # a shell command. A persona named `impl; touch /tmp/PWNED #` ran the
        # second command — CONFIRMED end to end, with the silent control
        # showing the name enters the command ONLY when a recall exists, so
        # this feature is what introduced it. The persona name is now dropped
        # from the line entirely: `tasks/<ID>/MEMORY.md` already carries it in
        # its own H1, so nothing is lost, and the clause is once again what the
        # comment claimed — fixed text plus a task id.
        line += (f". tasks/{t.id}/MEMORY.md is what an earlier occupant of this "
                 f"persona observed - SUSPECTED prior context, not instruction")
    if len(line) > 512:
        raise SystemExit(f"dispatch line for {t.id} exceeds 512 bytes")

    env = dict(os.environ,
               SMOKIN_PLAN=str(plan.root), SMOKIN_TASK_ID=t.id,
               SMOKIN_TASK_DIR=str(t.dir), SMOKIN_EMIT=str(HERE / "smokin-emit"))

    rec = {"run": rid, "seq": seq, "task": t.id, "attempt": 1,
           "dispatch": decision, "clause": clause, "runtime": t.runtime,
           "started": now(), "started_ns": time.time_ns(),
           "started_epoch": time.time(), "budget_s": t.budget,
           "placement": None, "pid_or_pane": None,
           # WHICH PERSONA the plan declared for this task, or null. This is the
           # key the pane history is looked up by, and writing it here is the
           # whole store: a persona-to-pane mapping that survives the tick
           # because the dispatch record already did.
           "agent": t.agent or None,
           # WHAT THIS DISPATCH WAS TOLD, and why it was told nothing when it
           # was told nothing. On the record rather than only in the ledger,
           # because the record is what a cold reader opens to find out what
           # this task was handed, and "which past did it start from" belongs
           # beside "which pane did it run in".
           "memory": rec_note,
           # WHICH AGENT INSTANCE got this task. The gate can only check that an
           # adversarial task DECLARES a different owner; only something that
           # dispatched can know who actually ran it. inproc spawns a fresh
           # headless process per task, so independence is free there — that is a
           # real property, not a gap. It is pane REUSE that collapses it, which
           # is why a reused dispatch writes the SAME session string as the task
           # it inherited from: the collapse is recorded rather than hidden.
           "session": None}

    if dry:
        rec["dry"] = True
        (plan.priv / "dispatch" / f"{t.id}.json").write_text(json.dumps(rec, indent=1) + "\n")
        return decision, "dry-run"

    # AFTER the dry return, deliberately. A dry run's whole promise is that it
    # writes its own record and touches nothing a worker would see; writing a
    # file into the task folder would break that, and MEMORY.md is a file a
    # worker is meant to read.
    if recall:
        (t.dir / "MEMORY.md").write_text(M.render(t.agent, recall, t.id))
        # EVERY RECALL GOES IN THE LEDGER. This is the diagnosis path: when a
        # task goes wrong in a way that looks like it started from a wrong
        # premise, the question "what was it handed, and where did that come
        # from" has to be answerable from files after the fact. A recall that
        # left no trace would make a bad association invisible — and a bad
        # association is the specific failure this mechanism can cause that no
        # other mechanism in the tool can.
        ledger(plan, event="memory-recall", task=t.id, agent=t.agent,
               n=len(recall), bytes=rec_note["bytes"], keys=rec_note["keys"],
               from_tasks=rec_note["from_tasks"],
               note="handed as SUSPECTED — the running system outranks it")
    else:
        ledger(plan, event="memory-recall", task=t.id, agent=t.agent or None,
               n=0, why=rec_note["why"])

    wrapper = str(HERE / "smokin-run")
    write_rec = lambda: (plan.priv / "dispatch" / f"{t.id}.json").write_text(
        json.dumps(rec, indent=1) + "\n")
    if decision == "pane":
        tmpl = row.get("pane") or f"{t.runtime} {{LINE}}"
        # QUOTED. Everything from `{LINE}` down is built by this file, but the
        # cost of being wrong about that once was arbitrary command execution
        # from a `**Agent:**` field, so the substitution no longer trusts its
        # own input. `shlex.quote` makes the line exactly one argument, which
        # is what every `pane` row in runtimes.json already means by `{LINE}`.
        inner = (tmpl.replace("{WT}", str(plan.root))
                     .replace("{LINE}", shlex.quote(line)))
        cmd = (f"SMOKIN_PLAN={plan.root} SMOKIN_EMIT={HERE/'smokin-emit'} "
               f"bash {wrapper} {t.id} -- {inner}")

        # Decided from files, before anything is asked of the world. The answer
        # rides on the dispatch record whichever way it went, so a cold reader
        # can see not just which pane ran this task but why it was that pane.
        rec["reuse"] = ru = reuse_decision(plan, t)
        ledger(plan, event="reuse-decision", task=t.id, agent=ru["agent"],
               reader=ru["reader"], allowed=ru["allowed"], klass=ru["class"],
               why=ru["why"], because=ru["because"], pane=ru["pane"],
               from_task=ru["from_task"])

        if ru["allowed"]:
            # THE ATTEMPT IS THE QUESTION. Nothing here asks herdr whether the
            # pane is alive, because a false `idle` is indistinguishable from a
            # finished agent (DESIGN §3j). It sends the command and reads the
            # return code. CONFIRMED 2026-08-19: a pane that is gone answers
            # `pane_not_found` and exits 1.
            rec["placement"] = ru["placement"]
            rec["pid_or_pane"] = ru["pane"]
            rec["session"] = ru["pane"]
            rec["reuse"]["used"] = True
            # Written BEFORE the attempt, same as every other dispatch: if this
            # process dies between here and the fall-back below, what is on disk
            # is a task pointed at a pane with no receipt, which the reaper
            # already knows how to turn into a result.
            write_rec()
            r = sh(["herdr", "pane", "run", ru["pane"], cmd])
            if r and r.returncode == 0:
                ledger(plan, event="pane-reused", task=t.id, agent=ru["agent"],
                       pane=ru["pane"], from_task=ru["from_task"],
                       klass=ru["class"],
                       note="containment: this task inherits the earlier task's context")
                return decision, f"{ru['pane']} (reused from {ru['from_task']})"
            # The attempt answered no. That is a fact about the world and the
            # only kind this design will act on — the decision above was a fact
            # about the plan's files, and neither is a lifecycle opinion.
            rec["reuse"]["used"] = False
            rec["reuse"]["fallback"] = ("herdr pane run returned "
                                        f"{r.returncode if r else 'nothing'}")
            ledger(plan, event="reuse-fallback", task=t.id, agent=ru["agent"],
                   pane=ru["pane"], why=rec["reuse"]["fallback"])

        pane = herdr_pane(plan, t)
        rec["placement"] = pane
        rec["pid_or_pane"] = pane and pane.get("pane")
        rec["session"] = pane and pane.get("pane")
        # the dispatch record is written BEFORE launch: that is what makes a
        # missing receipt mean something rather than being indistinguishable
        # from never-dispatched.
        write_rec()
        if pane:
            sh(["herdr", "pane", "run", pane["pane"], cmd])
            return decision, pane["pane"]
        return decision, "pane-unavailable"

    head = row.get("headless")
    if not head:
        return decision, "no-headless-mode"
    (plan.priv / "dispatch" / f"{t.id}.json").write_text(json.dumps(rec, indent=1) + "\n")
    argv = ["bash", wrapper, t.id, "--"] + head.split() + [line]
    p = subprocess.Popen(argv, cwd=str(plan.root), env=env,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    rec["pid_or_pane"] = p.pid
    rec["session"] = f"pid:{p.pid}"        # a fresh process = a fresh context
    (plan.priv / "dispatch" / f"{t.id}.json").write_text(json.dumps(rec, indent=1) + "\n")
    return decision, f"pid {p.pid}"


def sh(argv, timeout=20):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None


def herdr_pane(plan: Plan, t: Task):
    """Give this task its own TAB. Optional by construction: if herdr is absent
    the task still runs, it just runs without a screen.

    A TAB, NOT A SPLIT OF SOMEBODY ELSE'S PANE. This used to call
    `herdr pane split --current`, and `--current` is the OPERATOR'S pane — so
    every pane-dispatched task carved a slice out of whichever tab the human was
    sitting in. Observed directly: a workspace reached nine panes with three of
    them inside the operator's working tab, next to their own session and a
    long-running agent that must not be disturbed, and their terminal shrank
    with every dispatch. Nothing in the design intended that; `--current` was
    simply the easiest flag to reach for.

    A tab is full-size, labelled at creation, navigable, and leaves the
    operator's layout exactly as they arranged it.

    IT ALSO MAKES REUSE WORK. A tab persists and is addressable by id, so a
    persona dispatched a second time returns to its own tab with its own
    scrollback. A split pane is a slice of a layout somebody else owns and
    cannot be returned to once that layout changes — panes actively fight the
    reuse this file now does, and tabs make it natural.
    """
    if os.environ.get("HERDR_ENV") != "1":
        return None
    ws = os.environ.get("HERDR_WORKSPACE_ID", "")
    r = sh(["herdr", "tab", "create", "--workspace", ws,
            "--cwd", str(plan.root), "--label", f"smokin:{t.id}", "--no-focus"])
    if not r or r.returncode != 0:
        return None
    try:
        res = json.loads(r.stdout)["result"]
        pid = res["root_pane"]["pane_id"]
        tid = res["tab"]["tab_id"]
    except (ValueError, KeyError):
        return None
    # Labelled at creation, so there is no rename round-trip and no window in
    # which the tab sits on the operator's bar with a meaningless name.
    return {"pane": pid, "tab": tid, "workspace": ws}


# ── reaping and verdicts ────────────────────────────────────────────────────

def reap(plan: Plan, close_panes=False):
    """A missing receipt is a result. Runs INSIDE the tick — never a daemon,
    because a dead reaper turns a crashed worker into an orchestrator that
    waits forever, which is the failure Smokin exists to delete."""
    out = []
    d = plan.priv / "dispatch"
    if not d.is_dir():
        return out
    # The capability table, for one reason only: a reaped receipt still carries
    # `result`, and what shape that is hiding in is the runtime's property.
    # Read once outside the loop — reaping is not a place to re-read a file per
    # task — and never allowed to abort the reap, because a plan whose
    # runtimes.json went bad still has dead workers that must become results.
    try:
        rts = runtimes(plan)
    except SystemExit:
        rts = {}
    for f in sorted(d.glob("*.json")):
        try:
            rec = json.loads(f.read_text())
        except ValueError:
            continue
        tid = rec["task"]
        if (plan.root / "tasks" / tid / "RECEIPT.json").is_file():
            continue
        if time.time() - rec.get("started_epoch", 0) < rec.get("budget_s", DEFAULT_BUDGET):
            continue
        tr = plan.root / "tasks" / tid / ".smokin" / "transcript.log"
        text = tr.read_text(errors="replace") if tr.is_file() else ""
        # THE SECOND PLACE THE TAIL BECOMES A JSON ENVELOPE. The emitter had the
        # same 20-line fallback and both had to be fixed in one change, or a
        # reaped task would carry a machine blob in `result` while a cleanly
        # emitted one carried prose — the same field meaning two things
        # depending on which path wrote it.
        row = rts.get(rec.get("runtime"), {}) if rts else {}
        # GUARDED, exactly like the `usage_from` call twenty lines down, and for
        # the reason that call was guarded first: this reads a file a WORKER
        # wrote. An unguarded `lift_result` let a `RecursionError` out of a
        # deeply nested transcript line, out of `reap()` and out of the tick —
        # one task's transcript ended the orchestrator for every other task in
        # the plan, CONFIRMED with a healthy second task that then got no
        # receipt. The scanner no longer raises it either; both halves landed,
        # because one guard is a place a later change can quietly remove.
        try:
            tail = U.lift_result(text, row)
        except Exception:
            tail = None
        tail = tail or "\n".join(text.splitlines()[-20:])
        receipt = {"schema": "smokin.receipt/1", "seq": rec["seq"], "run": rec["run"],
                   "task": tid, "attempt": rec.get("attempt", 1), "terminal": "reaped",
                   "claim": "partial", "runtime": rec.get("runtime"),
                   "dispatch": rec.get("dispatch"), "source": "reaper", "exit": None,
                   "started": rec.get("started"), "ended": now(),
                   "wall_s": round(time.time() - rec.get("started_epoch", 0), 1),
                   "result": tail, "artifacts": {}, "placement": rec.get("placement")}
        # A reaped worker is one that ran out of budget, so most of the time it
        # printed no envelope and there is nothing to read. Sometimes it printed
        # one and then hung, and that spend was still real — it is recorded when
        # it is there and the key is absent when it is not. Never zero: a run
        # killed at its budget is the single worst place to invent a zero cost.
        try:
            usage = ({"available": False, "reason": "pane-not-instrumented"}
                     if rec.get("dispatch") == "pane" else U.usage_from(text, row))
        except Exception:
            usage = None
        if usage:
            receipt["usage"] = usage
        (plan.root / "tasks" / tid / "RECEIPT.json").write_text(json.dumps(receipt, indent=1) + "\n")
        # REAPED TASKS ONLY, AND THAT IS DELIBERATE — this loop has already
        # skipped every task that left a receipt, so a task that FINISHED keeps
        # its tab. Closing on success would look tidier and would delete pane
        # reuse in the same stroke: reuse sends the next task for a persona back
        # into the tab the last one finished in, and a closed tab is a pane that
        # answers `pane_not_found`. `--close` is reaper cleanup for a worker
        # that never spoke, the help text and DESIGN §2f now say so, and the
        # operator closes a finished tab the way they close any other.
        if close_panes and rec.get("dispatch") == "pane" and rec.get("pid_or_pane"):
            # SIGHUP, per experiment Q2b — the worker still gets to speak.
            #
            # CLOSE THE TAB, NOT THE PANE. Each dispatched task now owns a whole
            # tab, so closing only its pane would leave an EMPTY TAB on the
            # operator's bar — one per reaped task, accumulating exactly the
            # clutter that moving off pane-splitting was meant to remove. Fall
            # back to the pane for dispatch records written before tabs existed,
            # because a reap must work on a plan that was started by an older
            # build.
            tab = (rec.get("placement") or {}).get("tab")
            if tab:
                sh(["herdr", "tab", "close", str(tab)])
            else:
                sh(["herdr", "pane", "close", str(rec["pid_or_pane"])])
        ledger(plan, event="reaped", task=tid, seq=rec["seq"])
        out.append(tid)
    return out


def remember_verdict(plan: Plan, t: Task, v: dict):
    """A REFUTED gate is the one thing this tick observes that is worth carrying
    forward, and it is worth carrying because it is already fully evidenced.

    ONLY FAILURES. A gate that passed teaches the next occupant nothing — it
    says the work was done, which is what the receipt and the verdict already
    say, in two places, to a reader who can go and look. A gate that FAILED, and
    the exact command that showed it, is precisely the thing the next agent
    rediscovers by spending tokens, which is the incident this whole feature
    traces to. It also makes the silent control exact: **a plan in which
    everything passes writes no memory at all**, so the store cannot fill up
    with the ordinary course of events.

    THE TICK IS THE ONLY AUTOMATIC WRITER, and it writes only what it ran
    itself. Nothing here reads FINDINGS.md and harvests sentences out of it: a
    sentence an agent wrote about its own work has no command attached, would be
    refused by the guard, and harvesting it anyway would be this file deciding
    the guard applies to everyone else.

    An entry with no persona could never be recalled by one, so it is not
    written — and the decline goes in the ledger, because a plan that declares
    no `**Agent:**` is the COMMON case (9 of 20 shipped TASK.md declare it) and
    a mechanism that is silently off for most plans is indistinguishable from
    one that was never built."""
    if v.get("pass"):
        return None
    if not t.agent:
        ledger(plan, event="memory-skipped", task=t.id, why="agent-not-declared",
               note="a fact nobody can be identified by cannot be recalled by one")
        return None
    obs = (v.get("stderr") or "").strip() or (v.get("stdout") or "").strip() \
        or v.get("why") or f"exit {v.get('exit')}, no output"
    e = M.make("fact", t.agent, t.id,
               claim=f"the gate for {t.id} did not pass (exit {v.get('exit')})",
               observation=obs, command=v.get("cmd") or "", run=plan.run_id(),
               source="verdict")
    why = M.check(e)
    if why:
        # The guard bites the tick exactly as hard as it bites a human. A task
        # with no `## Done means` produces a verdict with no `cmd`, and that
        # verdict is refused here rather than stored as a fact whose evidence is
        # an empty string. Being refused by your own guard is the check working.
        ledger(plan, event="memory-refused", task=t.id, agent=t.agent,
               source="verdict", why=why)
        return None
    M.append(plan.priv, e)
    ledger(plan, event="memory-write", task=t.id, agent=t.agent, kind="fact",
           key=e["key"], source="verdict", claim=e["claim"])
    if M.crossed(M.read(plan.priv), e["key"]):
        ledger(plan, event="skill-candidate", key=e["key"], claim=e["claim"],
               personas=M.CANDIDATE_PERSONAS,
               note="reported, not written — evidence a skill should exist is not "
                    "authority to write one")
    return e


def take_verdict(plan: Plan, tid: str, write_status: bool = True,
                 remember: bool = True):
    """The tick re-runs the task's OWN done-command. A receipt is the agent's
    CLAIM; the verdict is the project's. Principle 8 one level down: a receipt
    may be a precondition of the gate, it may never BE the gate."""
    t = plan.tasks[tid]
    if not t.done_cmd:
        v = {"pass": False, "why": "no done-command", "at": now()}
    else:
        r = subprocess.run(t.done_cmd, shell=True, cwd=str(plan.root),
                           capture_output=True, text=True, timeout=120)
        blew = r.returncode in (126, 127)
        v = {"pass": r.returncode == 0 and not blew, "exit": r.returncode,
             "cmd": t.done_cmd, "at": now(),
             "why": "gate could not run (exit %d)" % r.returncode if blew else None,
             "stdout": (r.stdout or "")[-500:], "stderr": (r.stderr or "")[-500:]}
    (t.dir / "VERDICT.json").write_text(json.dumps(v, indent=1) + "\n")
    # `verify` passes write_status=False. At n=1 the human wrote TASK.md and
    # probably has it open; silent edits to someone's own prose are hostile, and
    # the rendered picture does not need it — Plan.state() reads the verdict
    # before it looks at anything else, so the status line is not load-bearing.
    if write_status:
        t.set_status("DONE" if v["pass"] else "BLOCKED")
    ledger(plan, event="verdict", task=tid, **{"pass": v["pass"]})
    # `verify` passes remember=False, and the reason is the same one that made
    # it pass write_status=False. `verify` is the door people adopt first
    # BECAUSE it is read-only, and a command that quietly starts accumulating a
    # memory store on somebody's disk the first time they try it is not
    # read-only in the sense that made them try it. The tick dispatched the
    # work and is entitled to record what it observed; verify did not.
    if remember:
        remember_verdict(plan, t, v)
    return v


def drain_spool(plan: Plan):
    """Claim BEFORE acting. rename(inbox -> done) is the only race-free
    primitive available; acting first and moving the pointer after leaves a
    window where kill -9 re-dispatches dependants onto still-running copies."""
    spool = plan.priv / "spool"
    inbox, done = spool / "inbox", spool / "done"
    done.mkdir(parents=True, exist_ok=True)
    claimed = []
    if not inbox.is_dir():
        return claimed
    for f in sorted(inbox.glob("*.json")):
        try:
            os.rename(f, done / f.name)          # the claim
        except OSError:
            continue                             # someone else got it
        try:
            claimed.append(json.loads((done / f.name).read_text())["task"])
        except (OSError, ValueError):
            pass
    return claimed


# ── tier 3 · the halt ───────────────────────────────────────────────────────
# A halt is a RESULT. The node stops, says exactly why, and waits for a human.
# The alternative — guessing and continuing — produces a finished-looking plan
# nobody can audit, which is worse than a plan that stopped.

def halted(plan: Plan):
    try:
        return json.loads((plan.priv / "HALT.json").read_text())
    except (OSError, ValueError):
        return None


def halt(plan: Plan, why: str, tier="3", task=None, broken=()):
    # `broken` rides on the halt record because HALT.json outlives the process
    # that wrote it. `smokin present` re-renders PROGRESS.md from files alone and
    # has no tick rows to hand it; without this the halt banner survived a
    # re-render and the three facts under it did not.
    rec = {"schema": "smokin.halt/1", "at": now(), "tier": tier,
           "task": task, "why": why, "run": plan.run_id(),
           "broken": [b for b in broken],
           "clear_with": f"smokin resume {plan.root}"}
    plan.priv.mkdir(parents=True, exist_ok=True)
    (plan.priv / "HALT.json").write_text(json.dumps(rec, indent=1) + "\n")
    ledger(plan, event="halt", tier=tier, task=task, why=why)
    return rec


def print_halt(rec):
    print(f"\nHALTED — tier {rec['tier']}"
          + (f" · task {rec['task']}" if rec.get("task") else ""))
    # Every line, not just the first. An invariant halt is a multi-line block —
    # command, expected reading, actual reading — and indenting only line one
    # made the evidence look like unrelated output from something else.
    for line in str(rec["why"]).splitlines() or [""]:
        print(f"  {line}".rstrip())
    print("\nNothing further will be dispatched until a human reads this and runs")
    print(f"  {rec['clear_with']}")


# ── tier 2 · judgement, invoked and then written down ───────────────────────

def judge_pass(plan: Plan, rts: dict, dry=False):
    """Ask one judge per outstanding ruling; record every answer; return the
    first halt reason, or None.

    There is no path through this function that advances a task without a judge
    having actually answered inside its budget with an outcome from the declared
    set. Every other path halts."""
    made = []
    if not plan.rules.active:
        return made, None
    if plan.rules.error:
        return made, (f"{R.CONFIG_NAME} does not load: {plan.rules.error}. No ruling is made in "
                      f"this plan until it is fixed — falling back to 'no rulings' would let a "
                      f"typo turn the judgement layer off while still looking like it works.")

    for tid in sorted(plan.tasks):
        v = plan.verdict(tid)
        if not (v and v.get("pass")):
            continue
        required, outstanding = plan.rulings_needed(tid)
        if required and required[0] == "<when raised>":
            return made, (f"a `when` expression raised while being evaluated for {tid}. An "
                          f"expression that throws is not False; see {R.CONFIG_NAME}.")
        if not required and plan.rules.policy.get("uncovered") == "halt":
            return made, (f"{tid} passed its gate and no declared ruling class covers it. "
                          f"The node does not decide what it was not told to decide. Either add a "
                          f"[[ruling]] whose `when` matches, or write `uncovered = \"accept\"` "
                          f"under [policy] so the choice is on the record.")
        for rule in outstanding:
            if dry:
                made.append({"class": rule["class"], "task": tid, "outcome": "(dry-run)"})
                continue
            prior = plan.standing.get((rule["class"], tid))
            print(f"  judging  {tid}  {rule['class']}  "
                  f"({rule['persona']} · {rule['model']} · {rule['effort']})")
            rec, why = R.invoke_judge(plan.root, plan.priv, rule, tid, rts,
                                      attempt=(prior or {}).get("attempt", 0) + 1)
            if why:
                return made, why                       # default = halt. Not configurable.
            if prior:
                # Judge shopping leaves a trail: the superseded ruling stays in
                # the file with its reason and is named by the one that replaced it.
                rec["supersedes"] = prior.get("seq")
                rec["supersedes_outcome"] = prior.get("outcome")
            rec = R.append_ruling(plan.priv, rec)
            plan.standing[(rule["class"], tid)] = rec
            made.append(rec)
            ledger(plan, event="ruling", task=tid, cls=rule["class"],
                   outcome=rec["outcome"], persona=rule["persona"])
            if rec["outcome"] not in R.ADVANCING and rec["outcome"] not in R.REJECTING:
                return made, (f"the judge for {rule['class']} on {tid} answered "
                              f"{rec['outcome']!r}: {rec['because']} This is tier 3 — it needs a "
                              f"human, not another agent.")
    return made, None


# ── tier 1 · what must remain true, and the baseline that says so ───────────
# Tier 1 by DELEGATION-NODE.md §3: the rule is the curator's and the node only
# applies it. No model, no tokens. The HALT it produces still needs a human —
# every halt does — but the DECISION was made mechanically by a declared reading,
# which is the cheapest tier that can catch this class of fault at all.

def invariant_pass(plan: Plan, dry=False, recapture=False):
    """Capture the baseline, or re-check it. Returns (rows, halt_reason).

    The baseline is per-RUN. `smokin reset` drops run.json, so the next command
    re-baselines against the world as it stands then — which is correct: a new
    run is a new before."""
    iset = plan.invariants
    if not iset.active:
        return [], None
    if iset.error:
        return [], (f"{I.CONFIG_NAME} does not load: {iset.error}. Nothing is dispatched in this "
                    f"plan until it is fixed — falling back to 'no invariants' would let a typo "
                    f"turn the blast-radius check off while the plan still looked guarded.")
    if dry:
        return [{"name": inv["name"], "ok": True, "actual": "(dry-run)"}
                for inv in iset.invariants], None

    run_id = plan.run_id()
    base = None if recapture else I.read_baseline(plan.priv)
    if base is None or base.get("run") != run_id:
        rec, err = I.capture(plan.root, plan.priv, iset, run_id)
        if err:
            return [], err
        ledger(plan, event="baseline", run=run_id, n=len(rec["readings"]),
               names=sorted(rec["readings"]), recaptured=bool(recapture))
        return [{"name": n, "ok": True, "actual": "(reference reading)"}
                for n in sorted(rec["readings"])], None

    rows, why = I.recheck(plan.root, plan.priv, iset, base)
    for r in rows:
        if not r["ok"]:
            ledger(plan, event="invariant-broken", name=r["name"], run=run_id,
                   expected=r["expected"], actual=r["actual"])
    return rows, why


def _broken(rows):
    return [{"name": r["name"], "expected": r.get("expected"),
             "actual": r.get("actual"), "because": r.get("because")}
            for r in rows if not r.get("ok")]


def print_invariants(rows):
    for r in rows:
        mark = "ok  " if r.get("ok") else "BROKE"
        print(f"  invariant {mark} {r['name']}"
              + (f"  {r['actual']}" if r.get("actual") in
                 ("(reference reading)", "(dry-run)") else ""))


# ── verify — the tick with the fleet removed ────────────────────────────────

def verify(plan: Plan, only=None):
    """Run each task's OWN done-command and record what happened. That is all.

    Starts nothing, creates no pane, drains no spool, reaps nothing, judges
    nothing. It takes the tick lock so it cannot race a real tick.

    WHY THIS EXISTS. Two users in a row wrote a plan, executed it with the one
    agent they already had, and never touched Smokin — the second on a job built
    to need it. The idea that would have helped both of them needs no fleet at
    all: the worker's claim is not evidence until something else re-runs the
    check. It was welded to dispatch, panes and a reaper they did not need, so
    they skipped the whole thing.

    At n=1 there is no worker to emit a receipt. YOU are the receipt, and this is
    the second hand.
    """
    plan.priv.mkdir(parents=True, exist_ok=True)
    lock = open(plan.priv / "tick.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("another tick holds the lock — nothing to do")
        return 0

    held = halted(plan)
    if held:
        print_halt(held)
        return 4

    # BEFORE the verdicts, because a done-command is itself something that runs.
    # At n=1 this is the whole before/after loop: the first `verify` of a run is
    # the "before", every later one is the "after", and nobody has to remember to
    # copy the paragraph into the next brief by hand.
    inv_rows, inv_why = invariant_pass(plan)
    print_invariants(inv_rows)
    if inv_why:
        rec = halt(plan, inv_why, tier="1", broken=_broken(inv_rows))
        st = render_status(plan, [], [], [], [], (), rec, inv_rows)
        write_progress(plan, st)
        print_halt(rec)
        return 4

    ids = [only] if only else sorted(plan.tasks)
    verdicted = []
    for tid in ids:
        if tid not in plan.tasks:
            print(f"smokin: no such task: {tid}", file=sys.stderr)
            return 2
        v = take_verdict(plan, tid, write_status=False, remember=False)
        verdicted.append(tid)
        print(f"  verdict  {tid}  {'PASS' if v['pass'] else 'REFUTED'}")

    plan.__init__(plan.root)

    # Independence cannot be established from here, so say so rather than let a
    # green line imply it. The gate checks the declaration; only something that
    # dispatched the work can check the actor, and nothing dispatched here.
    #
    # ONLY THE ADVERSARY. This used to fire on any `**Reader:**` at all, which
    # put the same warning on the HEALTH reader — the one role whose
    # contamination Grillin calls "required, not disqualifying". Warning that a
    # health reader's independence is unverified is not a cautious reading, it is
    # a wrong one: independence is not what that role is for, and the warning
    # would now contradict pane reuse, which deliberately hands the health reader
    # the same context again.
    #
    # AND WHERE THE PROOF IS ON DISK, IT IS A FAILURE AND NOT A NOTE. Both
    # halves were already in files this command reads: the task declares
    # `**Reader:** adversary` (plus the "not a continued session" sentence
    # Grillin's gate demands), and its own dispatch record says
    # `reuse.used: true` with the task it inherited from. Nothing joined them,
    # so `verify` printed PASS and "independence is unverified" over a record
    # stating in the same directory that independence was not merely unproven
    # but broken. This is the one independence check `verify` can make from
    # files alone: it starts nothing, edits no TASK.md and spends no model
    # call, and it catches every route into a reused adversary — including the
    # two regex divergences, which is why it is worth having even now that they
    # are closed.
    independence_broken = []
    for tid in sorted(plan.tasks):
        if plan.tasks[tid].reader != "adversary":
            continue
        ru = (plan.dispatch_rec(tid) or {}).get("reuse") or {}
        if ru.get("used"):
            independence_broken.append(tid)
            print(f"  FAIL     {tid} declares '**Reader:** adversary' and its dispatch "
                  f"record says it inherited {ru.get('pane')} from {ru.get('from_task')}. "
                  f"A reused agent IS a continued session, which is the one thing the "
                  f"task's own '**Context:** fresh' declaration says it is not.")
            continue
        print(f"  note     {tid} is declared adversarial. Nothing ran it here, so its "
              f"independence is unverified.")

    st = render_status(plan, [], verdicted, [], [], (), None, inv_rows)
    write_progress(plan, st)

    if plan.rules.active and not plan.rules.error:
        waiting = [t for t in plan.tasks if plan.ruling_state(t) == "judging"]
        if waiting:
            print(f"\n{len(waiting)} task(s) need a ruling; `smokin tick` is what asks. "
                  f"verify spends no model calls.")

    ready = plan.frontier()
    if len(ready) > 1:
        print(f"\n{len(ready)} tasks are ready at the same time ({', '.join(ready)}) — "
              f"that is what `smokin tick` is for.")

    ver = st["counts"]["verified"]
    print(f"\n{ver} of {st['total']} verified · see PROGRESS.md")
    if independence_broken:
        print(f"{len(independence_broken)} adversarial task(s) ran in an inherited "
              f"context: {', '.join(independence_broken)}. The gates may all pass and "
              f"the adversarial pass still be worth nothing.")
        return 1
    return 0 if plan.tasks and ver == st["total"] else 1


# ── the tick ────────────────────────────────────────────────────────────────

def plan_pulse(plan: Plan):
    """Everything a waiter could possibly be waiting FOR, as one comparable value.

    Deliberately derived from files and nothing else, for the same reason the
    tick is: there is no resident orchestrator to ask, and a waiter that held
    state would be a second thing to crash. A receipt arriving, a verdict being
    taken, a spooled claim landing, a halt being written, a person editing a
    status by hand — all of them move a file, so all of them move this.
    """
    marks = []
    for rel in ("spool/inbox", "dispatch"):
        d = plan.priv / rel
        if d.is_dir():
            for f in sorted(d.iterdir()):
                try:
                    marks.append((str(f), f.stat().st_mtime_ns, f.stat().st_size))
                except OSError:
                    pass
    for f in (plan.priv / "HALT.json", plan.root / "STATUS.json"):
        try:
            marks.append((str(f), f.stat().st_mtime_ns, f.stat().st_size))
        except OSError:
            pass
    td = plan.root / "tasks"
    if td.is_dir():
        for d in sorted(td.iterdir()):
            # ANSWER.md is in this list for the same reason RECEIPT.json is:
            # it is a thing arriving from outside that the plan can move on.
            for name in ("RECEIPT.json", "VERDICT.json", "TASK.md",
                         "QUESTIONS.md", "ANSWER.md"):
                f = d / name
                try:
                    marks.append((str(f), f.stat().st_mtime_ns, f.stat().st_size))
                except OSError:
                    pass
    return tuple(marks)


def task_settled(plan: Plan, tid):
    """Has this task stopped being something a waiter should keep waiting on?"""
    st = plan.state(tid)
    if st in ("verified", "refuted", "failed"):
        return st
    # A person's task never settles on its own, and a waiter that blocks on one
    # is a waiter that never returns. Say so immediately instead.
    t = plan.tasks.get(tid)
    if t is not None and t.human:
        return "human"
    return None


def wait(plan: Plan, tid=None, timeout=0.0, poll=1.0, quiet=False):
    """Block until there is something new to look at. Returns an exit code.

    THIS IS THE CURATOR'S PRIMITIVE, and it was missing. Operators were writing
    their own `wait-for-agent.sh` per agent and backgrounding one shell each,
    which works and which nobody should have to write: it re-implements, per
    site, the question `smokin` is already the authority on. The answer belongs
    here — it is EXECUTION, so it is Smokin's, not Grillin's.

    It still holds no state and starts nothing. It watches the plan directory,
    because the plan directory is where every answer already is.
    """
    if tid is not None and tid not in plan.tasks:
        print(f"smokin: no task {tid} in {plan.root} — there are: "
              f"{', '.join(sorted(plan.tasks)) or 'none'}", file=sys.stderr)
        return 2
    deadline = (time.time() + timeout) if timeout else None
    before = plan_pulse(plan)
    while True:
        plan.__init__(plan.root)
        if halted(plan):
            if not quiet:
                print_halt(halted(plan))
            return 4
        if tid is not None:
            got = task_settled(plan, tid)
            if got == "human":
                if not quiet:
                    print(f"{tid} is owned by a person — it will not settle on its "
                          f"own. Nothing to wait for.")
                return 5
            if got:
                if not quiet:
                    print(f"{tid} {got}")
                return 0 if got == "verified" else 1
        elif plan_pulse(plan) != before:
            if not quiet:
                print("the plan moved")
            return 0
        if deadline is not None and time.time() >= deadline:
            if not quiet:
                print(f"timed out after {timeout:g}s"
                      + (f" — {tid} is {plan.state(tid)}" if tid else ""))
            return 3
        time.sleep(poll)


def tick(plan: Plan, dry=False, close_panes=False):
    plan.priv.mkdir(parents=True, exist_ok=True)
    lock = open(plan.priv / "tick.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("another tick holds the lock — nothing to do")
        return 0

    held = halted(plan)
    if held:
        print_halt(held)
        return 4

    # FIRST, and before anything in this tick has touched the world. On tick 1 of
    # a run this captures the baseline — "before the first dispatch" is literally
    # true here, nothing below has run yet. On every later tick it is the AFTER
    # half of the loop for the tick that came before, and it halts before this
    # tick dispatches, so a plan does not add work on top of a broken machine.
    inv_rows, inv_why = invariant_pass(plan, dry=dry)
    print_invariants(inv_rows)
    if inv_why:
        rec = halt(plan, inv_why, tier="1", broken=_broken(inv_rows))
        st = render_status(plan, [], [], [], [], (), rec, inv_rows)
        write_progress(plan, st)
        print_halt(rec)
        return 4

    rts = runtimes(plan)
    reaped = reap(plan, close_panes)
    claimed = drain_spool(plan)

    verdicts = {}
    for tid in sorted(set(claimed) | set(reaped)):
        if tid in plan.tasks and not plan.verdict(tid):
            verdicts[tid] = take_verdict(plan, tid)

    plan.__init__(plan.root)                     # re-read: statuses changed

    rulings, why = judge_pass(plan, rts, dry=dry)
    plan.__init__(plan.root)                     # re-read: rulings changed states
    if why:
        rec = halt(plan, why, task=None)
        st = render_status(plan, reaped, list(verdicts), [], [], rulings, rec, inv_rows)
        write_progress(plan, st)
        for r in rulings:
            print(f"  ruling   {r.get('task')}  {r.get('class')}  {r.get('outcome')}")
        print_halt(rec)
        return 4
    for r in rulings:
        print(f"  ruling   {r.get('task')}  {r.get('class')}  {r.get('outcome')}")

    ceiling = PANE_CEILING[plan.size()]
    live_panes = sum(1 for f in (plan.priv / "dispatch").glob("*.json")
                     if json.loads(f.read_text()).get("dispatch") == "pane"
                     and not (plan.root / "tasks" /
                              json.loads(f.read_text())["task"] / "RECEIPT.json").is_file()) \
        if (plan.priv / "dispatch").is_dir() else 0

    dispatched, queued, awaiting, asked = [], [], [], []
    for tid in plan.frontier():
        t = plan.tasks[tid]
        decision, _ = t.route()
        # PARKED, NOT DISPATCHED, AND NOT A STOP. The BPMN reading is the right
        # one: a token sitting on a user task blocks THAT branch and nothing
        # else. So a person's task is set aside and the loop carries on with
        # every other ready task — the plan only comes to rest further down,
        # when nothing is in flight and the only work left is somebody's to do.
        # Status is deliberately NOT touched: a person has not started merely
        # because a tick noticed them.
        # AN OPEN QUESTION PARKS THE TASK, AND ONLY THE TASK. Same rule as a
        # person's task and for the same reason — the branch stops, the plan
        # does not. Re-dispatching a task that is waiting on a decision would
        # spend a model to be told the same thing again.
        if t.question:
            asked.append(tid)
            ledger(plan, event="awaiting-answer", task=tid,
                   why="QUESTIONS.md is open and no ANSWER.md sits beside it")
            continue
        if decision == "human":
            awaiting.append(tid)
            ledger(plan, event="awaiting-human", task=tid, owner=t.owner,
                   why="a person owns this task; no runtime may take it")
            continue
        # THE ADVERSARY, NOT ANY READER. This was `bool(RE_READER.search(...))`,
        # which fired on the health reader too and told an operator that a role
        # whose contamination is REQUIRED had got a clean, separate session. The
        # two roles have opposite contamination rules, so one sentence cannot be
        # true of both.
        adversarial = t.reader == "adversary"
        if decision == "pane" and live_panes >= ceiling:
            queued.append((tid, "pane-ceiling"))
            continue
        d, where = launch(plan, t, rts, dry=dry)
        if where in ("no-headless-mode", "pane-unavailable"):
            # Do NOT mark it started. A task marked IN PROGRESS with no dispatch
            # record is the state that cannot be told apart from a crash, and
            # inventing it here would defeat the whole reason the dispatch
            # record is written before launch.
            queued.append((tid, where))
            ledger(plan, event="dispatch-failed", task=tid, why=where)
            continue
        if d == "pane":
            live_panes += 1
        t.set_status("IN PROGRESS")
        dispatched.append((tid, d, where))
        ledger(plan, event="dispatched", task=tid, dispatch=d, where=str(where))
        if adversarial:
            # Say where the reader ran, so independence is READABLE rather than
            # asserted. Both dispatch paths give a fresh context — inproc spawns a
            # new process, pane splits a new pane — so under Smokin's own dispatch
            # independence holds by construction. That is worth stating plainly
            # instead of building an enforcement that can never fire. It is the
            # case Smokin did NOT dispatch — a human relaying every task to one
            # agent — that collapses it, and only `smokin verify` speaks to that.
            sess = (plan.dispatch_rec(tid) or {}).get("session")
            print(f"           {tid} is the adversary; it got its own session ({sess}), "
                  f"separate from every other task in this run.")
        # Panes only. An inproc dispatch is a fresh subprocess by construction,
        # so there is nothing there to reuse and nothing to say about it — which
        # is also why a plan with no pane tasks prints none of this and writes no
        # reuse events at all.
        # Read with `.get` throughout, never by key. This is a FILE, and it may
        # have been written by a different version of this program than the one
        # reading it — that is the whole premise of a stateless tick. A narrator
        # that raises on an unfamiliar record turns a cosmetic difference into a
        # dead plan.
        ru = (plan.dispatch_rec(tid) or {}).get("reuse")
        if ru and not dry:
            if ru.get("used"):
                print(f"           {tid} REUSED {ru.get('pane')} from "
                      f"{ru.get('from_task')} ({ru.get('class')}). Its context carries "
                      f"over — so does anything {ru.get('from_task')} got wrong.")
            else:
                # `why` is why the DECISION came out as it did; `fallback` is why
                # the decision did not survive contact with the world. Printing
                # `why` in the fallback case read as "reuse permitted, T1 left a
                # receipt" on a line announcing a fresh pane — true, and exactly
                # the wrong half of the story. Caught on a real herdr run.
                print(f"           {tid} opened a fresh pane — reuse "
                      f"{ru.get('class')}, "
                      f"{ru.get('fallback') or ru.get('why')}")

    plan.__init__(plan.root)
    st = render_status(plan, reaped, list(verdicts), dispatched, queued, rulings, None, inv_rows)
    write_progress(plan, st)

    for tid in reaped:
        print(f"  reaped   {tid}")
    for tid, v in verdicts.items():
        print(f"  verdict  {tid}  {'PASS' if v['pass'] else 'REFUTED'}")
    for tid, d, where in dispatched:
        print(f"  dispatch {tid}  {d}  {where}")
    for tid, why in queued:
        print(f"  queued   {tid}  ({why})")
    for tid in awaiting:
        print(f"  awaiting {tid}  a person owns this — {plan.tasks[tid].owner or 'owner unnamed'}")
    for tid in asked:
        print(f"  asked    {tid}  waiting on an answer — tasks/{tid}/QUESTIONS.md")

    inflight = st["counts"]["running"] + st["counts"]["claimed"] + st["counts"]["judging"]
    complete = st["counts"]["verified"] == len(plan.tasks) and plan.tasks
    # STUCK MEANS NOBODY CAN ACT. A frontier of parked human tasks is not that —
    # somebody can act, and it is not this program. Reading the two as one state
    # is what would make an operator go looking for a broken plan when the plan
    # is fine and waiting for them.
    parked = set(awaiting) | set(asked)
    ready_not_human = [tid for tid in st["frontier"] if tid not in parked]
    # An open question is not STUCK either. Stuck means nobody can act; here
    # somebody can, and the plan is holding the branch open for them.
    open_questions = [tid for tid in plan.tasks
                      if plan.tasks[tid].question and plan.state(tid) != "verified"]
    stuck = inflight == 0 and not st["frontier"] and not open_questions
    waiting_on_people = (inflight == 0 and not ready_not_human
                         and bool(parked or open_questions) and not complete)

    # THE CLOSING READING. The check at the top of a tick is the "after" for the
    # tick before it — but a plan that completes or gets stuck never gets a next
    # tick, so its last dispatch would be the one nothing ever measured. The most
    # expensive tick to skip is the last one: it is the one that ran the final
    # migration, and "the deploy finished and the neighbouring sites went down"
    # is precisely the shape the six briefs were guarding against.
    if (complete or stuck) and not dry:
        inv_rows2, inv_why2 = invariant_pass(plan)
        print_invariants(inv_rows2)
        if inv_why2:
            rec = halt(plan, inv_why2, tier="1", broken=_broken(inv_rows2))
            st = render_status(plan, reaped, list(verdicts), dispatched, queued,
                               rulings, rec, inv_rows2)
            write_progress(plan, st)
            print_halt(rec)
            return 4

    if complete:
        print(f"\nplan complete — {len(plan.tasks)}/{len(plan.tasks)} verified")
        return 0
    if stuck:
        print("\nnothing in flight and nothing ready — the plan is STUCK")
        return 3
    if waiting_on_people:
        # A DISTINCT RESULT, not a variant of stuck and not a halt. Nothing is
        # wrong, nothing is broken, and there is nothing this program can do
        # next. Naming it separately is what lets `run` stop cleanly instead of
        # spinning against work no runtime is allowed to take.
        bits = [f"{tid} ({plan.tasks[tid].owner or 'owner unnamed'})" for tid in awaiting]
        bits += [f"{tid} asks — tasks/{tid}/QUESTIONS.md" for tid in
                 sorted(set(asked) | set(open_questions))]
        print(f"\nnothing in flight — WAITING ON A PERSON: {', '.join(bits)}")
        print("Everything a runtime could take has been taken.")
        if asked or open_questions:
            print("Answer by writing ANSWER.md beside the question. `smokin run` is")
            print("watching for it and carries on by itself when it lands.")
        else:
            print("Do the task(s) above and set the status; `smokin run` is watching")
            print("the plan directory and carries on by itself.")
        return 5
    print(f"\n{inflight} in flight · see PROGRESS.md")
    return 1


# ── the presenter ───────────────────────────────────────────────────────────
# Split deliberately in two. `render_status` produces STATUS.json — machine
# truth, derived only from files. `write_progress` renders PROGRESS.md and may
# read NOTHING except that object. Same rule as Grillin's reader model: the
# thing that narrates is not allowed to re-derive the facts it narrates, or it
# will eventually narrate something that is not true.

GLYPH = {"verified": "●", "judging": "◍", "claimed": "◑", "running": "◐", "ready": "○",
         "blocked": "⊘", "refuted": "✗", "rejected": "✗", "escalated": "⚑", "uncovered": "⚑"}
WORD = {"verified": "verified", "judging": "awaiting a ruling",
        "claimed": "claimed, ungated", "running": "running", "ready": "ready",
        "blocked": "blocked", "refuted": "REFUTED", "rejected": "REJECTED by a judge",
        "escalated": "ESCALATED — needs a human", "uncovered": "no ruling class covers it"}


def render_status(plan: Plan, reaped, verdicted, dispatched, queued,
                  rulings=(), halt_rec=None, invariants=()):
    rows, counts = [], {k: 0 for k in GLYPH}
    for tid in sorted(plan.tasks):
        t, s = plan.tasks[tid], plan.state(tid)
        counts[s] = counts.get(s, 0) + 1
        r = plan.receipt(tid) or {}
        d = plan.dispatch_rec(tid) or {}
        held = [v for (c, k), v in plan.standing.items() if k == tid]
        rows.append({
            "rulings": sorted(({"class": v.get("class"), "outcome": v.get("outcome"),
                                "persona": v.get("persona"), "model": v.get("model"),
                                "effort": v.get("effort"), "because": v.get("because"),
                                "seq": v.get("seq"),
                                "supersedes": v.get("supersedes")} for v in held),
                              key=lambda x: x["seq"] or 0),
            "id": tid, "state": s, "owner": t.owner, "runtime": t.runtime,
            "agent": t.agent or None, "reader": t.reader or None,
            # Not "which pane" — which task's CONTEXT this one is standing in.
            # Null on every task that got its own, which is still most of them.
            "reused_from": ((d.get("reuse") or {}).get("from_task")
                            if (d.get("reuse") or {}).get("used") else None),
            "dispatch": (d.get("dispatch") or t.route()[0]),
            "clause": d.get("clause"), "where": d.get("pid_or_pane"),
            "blocked_by": sorted(t.blocked_by),
            "waiting_on": sorted(b for b in t.blocked_by
                                 if b in plan.tasks and plan.state(b) != "verified"),
            # `human` FIRST, because it is the only one of these that means the
            # task will never be dispatched at all. The other three mean a task
            # a runtime CAN take needs a person at some point in it.
            "needs_human": t.human or t.interrupt or t.type == "ASK"
                           or (plan.root / "tasks" / tid / "QUESTIONS.md").is_file(),
            "human_owned": t.human,
            "claim": r.get("claim"), "terminal": r.get("terminal"),
            "result": (r.get("result") or "").strip().splitlines()[-1:] or [""],
            "wall_s": r.get("wall_s"),
            "elapsed_s": round(time.time() - d["started_epoch"]) if d.get("started_epoch")
                         and s == "running" else None,
            "budget_s": d.get("budget_s"),
        })
    base = I.read_baseline(plan.priv)
    st = {"schema": "smokin.status/2", "run": plan.run_id(), "at": now(),
          "plan": str(plan.root), "size": plan.size(),
          "pane_ceiling": PANE_CEILING[plan.size()],
          # The incident's own number. Six agents idle, a seventh pane opened —
          # so what this run has to answer for is how many panes it OPENED, not
          # how many tasks it dispatched into panes.
          "panes": pane_census(plan),
          # Additive, and the schema stays `smokin.status/2` for the same reason
          # the receipt stayed `/1` when `usage` arrived: a reader that does not
          # know about this key ignores it, which is what additive means, and a
          # version bump would cost every reader in this repo and in Grillin a
          # branch to gain nothing.
          "memory": M.census(M.read(plan.priv), plan.run_id()),
          "counts": counts, "total": len(plan.tasks), "tasks": rows,
          "frontier": plan.frontier(),
          "judgement": {"active": plan.rules.active, "source": plan.rules.source,
                        "error": plan.rules.error,
                        "uncovered": plan.rules.policy.get("uncovered"),
                        "classes": [r["class"] for r in plan.rules.rulings]},
          "invariants": {"active": plan.invariants.active,
                         "source": plan.invariants.source,
                         "error": plan.invariants.error,
                         "declared": [i["name"] for i in plan.invariants.invariants],
                         "baseline_at": (base or {}).get("at"),
                         "baseline_run": (base or {}).get("run"),
                         "checked": [r["name"] for r in invariants],
                         # A re-render with no tick behind it has no rows, so it
                         # falls back to what the halt recorded when it fired.
                         "broken": _broken(invariants)
                                   or ((halt_rec or {}).get("broken") or [])},
          "halt": halt_rec,
          "this_tick": {"reaped": reaped, "verdicted": verdicted,
                        "dispatched": [d[0] for d in dispatched],
                        "queued": [q[0] for q in queued],
                        "ruled": [f"{r.get('task')}/{r.get('class')}={r.get('outcome')}"
                                  for r in rulings]}}
    (plan.root / "STATUS.json").write_text(json.dumps(st, indent=1) + "\n")
    return st


def bar(done, total, width=28):
    if not total:
        return "─" * width
    f = int(round(width * done / total))
    return "█" * f + "░" * (width - f)


def write_progress(plan: Plan, st: dict):
    """PROGRESS.md — the human surface. Reads only `st`."""
    L, c, tot = [], st["counts"], st["total"]
    ver = c.get("verified", 0)
    L.append("# Where the plan is")
    L.append("")
    L.append(f"`{bar(ver, tot)}`  **{ver} of {tot} verified**")
    L.append("")
    L.append(f"*run `{st['run']}` · size {st['size']} · rendered {st['at']} · "
             f"regenerated every tick — do not edit by hand*")
    L.append("")

    if st.get("halt"):
        h = st["halt"]
        L.append(f"## ⛔ HALTED — tier {h['tier']}")
        L.append("")
        # Every line gets its own `>`. An invariant halt is a multi-line block —
        # command, expected, actual — and lazy blockquote continuation turns the
        # indented lines into a code span and eats the reasons.
        for line in str(h["why"]).splitlines() or [""]:
            L.append(f"> {line}".rstrip())
        L.append("")
        L.append(f"Nothing further is dispatched until a human reads this and runs "
                 f"`{h['clear_with']}`. A halt that says why is a result; a node that "
                 f"guessed and continued would not be.")
        L.append("")

    broke = (st.get("invariants") or {}).get("broken") or []
    if broke:
        L.append("## ⛔ Something that had to stay true stopped being true")
        L.append("")
        for b in broke:
            L.append(f"- **{b['name']}**")
            L.append(f"    - expected  `{b['expected']}`")
            L.append(f"    - actual    `{b['actual']}`")
            L.append(f"    - declared because: {b['because']}")
        L.append("")
        L.append(f"*Measured against the baseline taken at "
                 f"{(st.get('invariants') or {}).get('baseline_at')}, before the first dispatch "
                 f"of this run. No task's own done-command looks at any of this — a task can "
                 f"pass its gate and break this in the same minute, which is the entire reason "
                 f"it is declared at plan level.*")
        L.append("")

    esc = [t for t in st["tasks"] if t["state"] in ("escalated", "uncovered")]
    if esc:
        L.append("## ⚑ A judge could not decide, or nothing was asked")
        L.append("")
        for t in esc:
            last = (t["rulings"] or [{}])[-1]
            L.append(f"- **{t['id']}** — {WORD[t['state']]}."
                     + (f" `{last.get('class')}` → **{last.get('outcome')}**: "
                        f"{last.get('because')}" if last.get("outcome") else ""))
        L.append("")

    rej = [t for t in st["tasks"] if t["state"] == "rejected"]
    if rej:
        L.append("## ✗ Gate passed, a judge said no")
        L.append("")
        for t in rej:
            for r in t["rulings"]:
                if r["outcome"] not in ("accept",):
                    L.append(f"- **{t['id']}** — `{r['class']}` → **{r['outcome']}** "
                             f"({r['persona']} · {r['model']} · {r['effort']}). {r['because']}")
        L.append("")
        L.append("*This is the layer the mechanical gate cannot reach: the command exited zero and "
                 "someone who did not write the work read it and disagreed.*")
        L.append("")

    need = [t for t in st["tasks"] if t["needs_human"] and t["state"] not in ("verified",)]
    if need:
        L.append("## ⏸ Waiting on you")
        L.append("")
        for t in need:
            where = f" · pane `{t['where']}`" if t["where"] else ""
            L.append(f"- **{t['id']}** — {WORD[t['state']]}{where}. "
                     f"{'Has open QUESTIONS.md.' if t['claim'] == 'blocked' else 'Declared as needing a human.'}")
        L.append("")

    ref = [t for t in st["tasks"] if t["state"] == "refuted"]
    if ref:
        L.append("## ✗ Said done, gate disagreed")
        L.append("")
        for t in ref:
            L.append(f"- **{t['id']}** — the agent claimed `{t['claim']}`, its own done-command "
                     f"exited non-zero. This is the receipt-versus-verdict split doing its job.")
        L.append("")

    L.append("## Every task")
    L.append("")
    L.append("| | Task | State | Owner | Where | Waiting on |")
    L.append("|---|---|---|---|---|---|")
    for t in st["tasks"]:
        el = ""
        if t["elapsed_s"] is not None:
            el = f" {t['elapsed_s']}s/{t['budget_s']}s"
        elif t["wall_s"]:
            el = f" {t['wall_s']}s"
        where = f"`{t['where']}`" if t["where"] else ("—" if t["state"] in ("ready", "blocked") else t["dispatch"])
        L.append(f"| {GLYPH[t['state']]} | **{t['id']}** | {WORD[t['state']]}{el} | "
                 f"{t['owner'] or '—'} | {where} | {', '.join(t['waiting_on']) or '—'} |")
    L.append("")

    pc = st.get("panes") or {}
    if pc.get("dispatches"):
        L.append("## What this run cost in panes")
        L.append("")
        L.append(f"**{pc['opened']} pane(s) opened** for {pc['dispatches']} pane "
                 f"dispatch(es); {pc['reused']} reused a persona that had already "
                 f"finished a task in this plan.")
        L.append("")
        inherited = [t for t in st["tasks"] if t.get("reused_from")]
        for t in inherited:
            L.append(f"- **{t['id']}** is standing in **{t['reused_from']}**'s context "
                     f"(persona `{t['agent']}`, pane `{t['where']}`)")
        if inherited:
            L.append("")
        L.append("*This is the reading the original incident had no number for: six agents "
                 "sat idle holding exactly the context the next tasks needed, and a seventh "
                 "pane was opened. **Reuse is not free.** A reused pane keeps the session "
                 "alive across the task boundary, so a wrong belief formed in the earlier "
                 "task survives into the later one, and the later task's own done-command "
                 "cannot see it. Every decision, taken and declined, is in "
                 "`.smokin/ledger.jsonl` with the sentence that decided it.*")
        L.append("")

    mem = st.get("memory") or {}
    # Only when there IS something. A plan that never refuted a gate has an
    # empty store, and an empty store renders NOTHING — which is what makes
    # "PROGRESS.md gains no memory section when nothing was remembered" an exact
    # control rather than a promise. It is also the honest picture: a heading
    # over a zero is a feature advertising itself.
    if mem.get("entries"):
        L.append("## What this run wrote down")
        L.append("")
        L.append(f"**{mem['entries']} entr(ies)** across {len(mem['personas'])} "
                 f"persona(s) — {mem['facts']} observed by the tick, {mem['lessons']} "
                 f"written by hand. {mem['this_run']} of them are in scope for recall "
                 f"in this run.")
        L.append("")
        L.append("*Every entry carries the task it came from, what was observed, and "
                 "the command that produced it — an entry without that triple is refused "
                 "at write time, because advice nobody can re-run reads exactly like a "
                 "fact. What is handed to a dispatched agent is marked SUSPECTED and "
                 "never as instruction: it is a document written against a snapshot, and "
                 "the running system outranks it. Every recall is in "
                 "`.smokin/ledger.jsonl`, so a wrong association is diagnosable rather "
                 "than invisible.*")
        L.append("")
        for c in mem.get("skill_candidates") or []:
            L.append(f"> **Skill candidate.** {len(c['personas'])} different personas "
                     f"({', '.join(f'`{p}`' for p in c['personas'])}) observed the same "
                     f"thing: *{c['claim']}*. That has stopped being one agent's "
                     f"experience. **No skill has been written** — a skill is a document "
                     f"somebody has to keep true, and evidence that one should exist is "
                     f"not authority to write it.")
            L.append("")

    tt = st["this_tick"]
    if any(tt.values()):
        L.append("## What changed this tick")
        L.append("")
        for k, label in (("dispatched", "dispatched"), ("verdicted", "gated"),
                         ("ruled", "ruled on by a judge"),
                         ("reaped", "reaped — budget expired, no receipt"),
                         ("queued", "held at the pane ceiling")):
            if tt[k]:
                L.append(f"- **{label}:** {', '.join(tt[k])}")
        L.append("")

    L.append("## Reading this")
    L.append("")
    L.append("| | Means |")
    L.append("|---|---|")
    L.append("| ● verified | gate passed **and** every ruling the plan asked for came back `accept` |")
    L.append("| ◍ awaiting a ruling | gate passed; a judge has not answered yet |")
    L.append("| ◑ claimed, ungated | the agent said it finished. Nothing has checked that yet |")
    L.append("| ◐ running | dispatched, inside its budget, no receipt |")
    L.append("| ○ ready | every blocker is verified; the next tick will dispatch it |")
    L.append("| ⊘ blocked | waiting on the tasks in the last column |")
    L.append("| ✗ REFUTED | claimed done, the mechanical gate said otherwise |")
    L.append("| ✗ REJECTED | gate passed, a judge who did not write the work said otherwise |")
    L.append("| ⚑ escalated | a judge answered *insufficient-evidence*, or nothing was asked. A human decides |")
    L.append("")
    j = st.get("judgement") or {}
    if j.get("active"):
        L.append(f"*Judgement layer: **on** — {len(j.get('classes') or [])} declared class(es) "
                 f"({', '.join(j.get('classes') or []) or '—'}), uncovered = "
                 f"`{j.get('uncovered')}`. Every ruling, including superseded ones, is in "
                 f"`.smokin/rulings.jsonl` with the reason it was made.*")
    else:
        L.append("*Judgement layer: **off** — no `_RULINGS.toml` beside the plan, so ● means the "
                 "mechanical gate and nothing more.*")
    L.append("")
    L.append("**● ◑ and ✗-by-a-judge are three different statements and the differences are the "
             "point.** A receipt is the worker's claim about itself; a verdict is the project's own "
             "gate re-run by the tick; a ruling is a judgement by someone who did not write the "
             "work. Everything here is derived from files in this directory — delete every agent "
             "and re-run `smokin tick` and the same picture comes back.")
    (plan.root / "PROGRESS.md").write_text("\n".join(L) + "\n")


# ── doctor ──────────────────────────────────────────────────────────────────

def doctor(plan: Plan):
    rts = runtimes(plan)
    out = {"at": now(), "runtimes": {}, "host": {}}
    for name, row in rts.items():
        head = (row.get("headless") or "").split()
        out["runtimes"][name] = {
            "installed": bool(head and shutil.which(head[0])),
            "path": shutil.which(head[0]) if head else None,
            "headless": bool(row.get("headless")), "pane": bool(row.get("pane"))}
    out["host"] = {
        "herdr": bool(shutil.which("herdr")), "inside_herdr": os.environ.get("HERDR_ENV") == "1",
        "python": sys.version.split()[0],
        "sh": os.path.realpath("/bin/sh"),
        "same_filesystem": None, "fs_note": None}
    try:
        a = os.stat(plan.root).st_dev
        (plan.priv).mkdir(parents=True, exist_ok=True)
        b = os.stat(plan.priv).st_dev
        out["host"]["same_filesystem"] = (a == b)
        # inotify is silent on DrvFs/9p. This is WSL: a plan under /mnt/c stops
        # delivering events, so the poll backstop is not optional there.
        out["host"]["fs_note"] = ("plan is under /mnt — inotify will not fire, polling only"
                                 if str(plan.root).startswith("/mnt/") else "native fs")
    except OSError:
        pass
    plan.priv.mkdir(parents=True, exist_ok=True)
    (plan.priv / "doctor.json").write_text(json.dumps(out, indent=1) + "\n")
    print(f"host      sh={out['host']['sh']}  herdr={'yes' if out['host']['herdr'] else 'no'}"
          f"  inside={'yes' if out['host']['inside_herdr'] else 'no'}")
    print(f"          filesystem: {out['host']['fs_note']}")
    for n, r in sorted(out["runtimes"].items()):
        mark = "ok      " if r["installed"] else "MISSING "
        print(f"runtime   {mark}{n:<12} headless={'y' if r['headless'] else 'n'} "
              f"pane={'y' if r['pane'] else 'n'}")
    missing = [n for n, r in out["runtimes"].items() if not r["installed"]]
    if missing:
        print(f"\n{len(missing)} runtime(s) declared and not installed: {', '.join(missing)}.")
        print("Learn it here, not from a gate that passed because a missing binary")
        print("exits 127 and looks like a clean failure.")
    return 0


def reset(plan: Plan, run):
    n = 0
    for p in list((plan.priv / "dispatch").glob("*.json")) if (plan.priv / "dispatch").is_dir() else []:
        p.unlink(); n += 1
    for d in ("spool/inbox", "spool/done", "spool/tmp"):
        for p in list((plan.priv / d).glob("*")) if (plan.priv / d).is_dir() else []:
            p.unlink(); n += 1
    for tid in plan.tasks:
        # The output contract goes too. A task back at NOT STARTED whose
        # FINDINGS.md is still on disk is incoherent state, and Grillin's gate
        # says so precisely: the done-command passes before any work is done,
        # so an orchestrator would mark unstarted work complete. Found by
        # running validate-plan.py against this repo's own example.
        # MEMORY.md goes with them, and it is the one file in this list that
        # Smokin wrote rather than the worker: it is a RECALL, rendered for one
        # dispatch out of the store. Leaving it behind would hand the next
        # occupant of this task a file the next dispatch did not decide to give
        # it. The store itself is not touched — see below.
        for f in ("RECEIPT.json", "VERDICT.json", ".smokin/emit.lock", "MEMORY.md",
                  "FINDINGS.md", "CHANGES.md", "QUESTIONS.md"):
            p = plan.root / "tasks" / tid / f
            if p.exists():
                p.unlink(); n += 1
        tr = plan.root / "tasks" / tid / ".smokin" / "transcript.log"
        if tr.exists():
            tr.unlink(); n += 1
        plan.tasks[tid].set_status("NOT STARTED")
    # Rulings are NOT deleted. They are retired by appending a retirement, so the
    # ruling and its reason stay readable after the run they judged is gone.
    # Deleting them would make a reset the cheapest way to erase an inconvenient
    # judgement, which is exactly the trail this design exists to leave.
    retired = 0
    for (cls, tid), rec in sorted(R.standing(plan.priv).items()):
        R.append_ruling(plan.priv, {"class": cls, "task": tid, "retired": True,
                                    "retires": rec.get("seq"), "outcome": rec.get("outcome"),
                                    "because": f"retired by `smokin reset` (was: {rec.get('because')})"})
        retired += 1
    # `.smokin/memory.jsonl` is NOT deleted, for the reason directly above: an
    # entry is an observation with the command that produced it, and deleting it
    # would make `smokin reset` the cheapest way to erase an inconvenient
    # measurement. It does not leak into the next run either — recall filters on
    # the run id, and reset removes `run.json`, so the next run gets a new one
    # and starts its recall empty. The archive stays readable via `smokin memory`.
    # The baseline IS deleted, and that is not inconsistent with keeping rulings.
    # A ruling is a judgement someone made and must stay readable; a baseline is a
    # measurement of one run's starting world, and after a reset that world is not
    # the world the next run starts in. Keeping it would silently measure the new
    # run against the old run's before. The capture is in the ledger either way.
    if I.baseline_path(plan.priv).exists():
        I.baseline_path(plan.priv).unlink(); n += 1
    (plan.priv / "HALT.json").unlink(missing_ok=True)
    (plan.priv / "run.json").unlink(missing_ok=True)
    print(f"reset: removed {n} artefact(s), retired {retired} ruling(s); "
          f"all tasks back to NOT STARTED")
    return 0


def show_memory(plan: Plan):
    """Read-only. A store nothing can print is a store nobody can audit, and
    this one is the only mechanism in the tool that puts words in front of a
    worker — which makes being able to read exactly what it would say the
    minimum price of shipping it."""
    entries = M.read(plan.priv)
    rid = plan.run_id()
    print(f"plan:   {plan.root}")
    print(f"store:  {M.store(plan.priv)}"
          f"{'' if M.store(plan.priv).is_file() else '  (none yet)'}")
    if not entries:
        print("\nNothing has been written down. The tick writes a fact when a gate is "
              "REFUTED and\nthe task declares an `**Agent:**`; `smokin remember` is the "
              "hand-written door.")
        return 0
    by = {}
    for e in entries:
        by.setdefault(e.get("agent") or "(no persona)", []).append(e)
    for agent in sorted(by):
        rows = by[agent]
        live = sum(1 for e in rows if e.get("run") == rid)
        print(f"\n{agent} — {len(rows)} entr(ies), {live} in scope for recall this run")
        for e in rows:
            scope = "recalled" if e.get("run") == rid else "archived"
            print(f"  [{scope}] {e.get('kind')} · {e.get('task')} · {e.get('at')}")
            print(f"    {e.get('claim')}")
            print(f"    $ {e.get('command')}")
    cands = M.candidates(entries)
    if cands:
        print(f"\nSKILL CANDIDATES — the same observation from "
              f"{M.CANDIDATE_PERSONAS}+ different personas:")
        for c in cands:
            print(f"  {c['claim']}")
            print(f"    personas: {', '.join(c['personas'])}")
        print("\nReported, not written. A skill is a document somebody has to keep true;")
        print("evidence that one should exist is not authority to write it.")
    else:
        print(f"\nNo skill candidate — no single observation has come from "
              f"{M.CANDIDATE_PERSONAS} different personas.")
    print(f"\nRecall hands a dispatched agent at most {M.RECALL_MAX} entries from this "
          f"run, marked\nSUSPECTED. Nothing auto-applies. Every recall is in "
          f"`.smokin/ledger.jsonl`.")
    return 0


def remember(plan: Plan, a):
    """The hand-written door, and the door the guard exists for.

    The tick writes facts it observed itself. This is where a human — or an
    agent that was told to, or a judge who noticed something — writes a LESSON,
    which is the generalisation step, which is exactly the step where the
    evidence normally gets left behind. So it is refused without the command,
    loudly and with a non-zero exit, rather than stored with a warning: a stored
    warning is still stored, and still gets recalled.

    THE OBVIOUS SECOND AUTOMATIC SOURCE IS DELIBERATELY NOT WIRED. The rulings
    layer produces a judgement with a `because`, which reads like the most
    valuable thing in the plan to remember — and it has no command behind it,
    so it would be refused by this same guard. That is the guard being right,
    not the guard being inconvenient: a judgement is somebody's reasoning about
    evidence, not the evidence, and the place for it is `rulings.jsonl` where it
    already keeps its whole trail. If a judge wants something remembered, a
    human can run this command and attach the command that would show it."""
    e = M.make(a.kind, a.agent, a.task, a.claim, a.observation, a.command,
               run=plan.run_id(), source="remember")
    why = M.check(e)
    # AND THE TASK HAS TO EXIST. `check` cannot see a plan directory and should
    # not learn to; this is the caller's half. `--task T999-does-not-exist` was
    # stored and recalled with provenance that pointed at nothing, which is the
    # one thing an entry's own provenance line is for. A file check, not a
    # semantic one: it kills invented provenance and makes no claim about
    # whether a real id is the RIGHT id.
    if not why and e["task"] not in plan.tasks:
        known = ", ".join(sorted(plan.tasks)) or "none"
        why = (f"refused: task {e['task']!r} is not a task in this plan (known: "
               f"{known}). Every entry names the task it came from, and a "
               f"provenance line pointing at nothing is worse than no entry — a "
               f"reader who goes to check it finds an empty folder and cannot "
               f"tell a typo from a fabrication.")
    if why:
        print(f"smokin: {why}", file=sys.stderr)
        ledger(plan, event="memory-refused", task=a.task, agent=a.agent,
               source="remember", why=why)
        return 2
    M.append(plan.priv, e)
    ledger(plan, event="memory-write", task=e["task"], agent=e["agent"],
           kind=e["kind"], key=e["key"], source="remember", claim=e["claim"])
    print(f"remembered [{e['kind']}] for `{e['agent']}`: {e['claim']}")
    print(f"  it will be recalled to `{e['agent']}` in run {e['run']}, marked SUSPECTED, "
          f"bounded to {M.RECALL_MAX} entries.")
    if M.crossed(M.read(plan.priv), e["key"]):
        ledger(plan, event="skill-candidate", key=e["key"], claim=e["claim"],
               personas=M.CANDIDATE_PERSONAS,
               note="reported, not written")
        print(f"\nSKILL CANDIDATE: {M.CANDIDATE_PERSONAS} different personas have now "
              f"observed this.\nReported, not written — see `smokin memory`.")
    return 0


def show_rulings(plan: Plan):
    """A silent config is indistinguishable from a working one unless something
    can print it."""
    rs = plan.rules
    print(f"plan:   {plan.root}")
    print(f"source: {rs.source or '(none — judgement layer is OFF; ● means the gate only)'}")
    if rs.error:
        print(f"\nERROR:  {rs.error}")
        print("        No ruling is made in this plan until it is fixed. This is deliberate:")
        print("        falling back to 'no rulings' would let a typo turn the judgement")
        print("        layer off while still looking like it works.")
        return 1
    if not rs.active:
        return 0
    print(f"policy: uncovered = {rs.policy.get('uncovered')}"
          + ("   (a gate-passing task no class covers HALTS)"
             if rs.policy.get("uncovered") == "halt"
             else "   (a gate-passing task no class covers advances — on the record)"))
    rts = runtimes(plan)
    print(f"classes: {len(rs.rulings)}")
    for r in rs.rulings:
        row = rts.get(r["runtime"]) or {}
        cmd = row.get("judge") or row.get("headless") or ""
        print(f"  {r['class']}")
        print(f"      when      {r['when_src']}")
        print(f"      judge     {r['persona']} · {r['model']} · {r['effort']} "
              f"· runtime {r['runtime']} · {r['budget_s']}s")
        if not cmd:
            print(f"      WARNING   runtime {r['runtime']!r} has no headless mode. This class "
                  f"cannot be judged; the tick will halt on it.")
        else:
            missing = [w for w, ph in (("model", "{MODEL}"), ("effort", "{EFFORT}"))
                       if ph not in cmd]
            if missing:
                print(f"      NOTE      the {r['runtime']!r} command applies no "
                      f"{' or '.join(missing)} — the roster's pairing is a request here, not a "
                      f"setting. Each ruling records what was actually applied.")
        print(f"      evidence  {', '.join(r['evidence'])}")
        print(f"      outcomes  {', '.join(r['outcomes'])}   (default: {r['default']})")
    led = R.read_ledger(plan.priv)
    if led:
        print(f"\nledger: {len(led)} ruling(s) recorded in .smokin/rulings.jsonl")
        for rec in led[-8:]:
            if rec.get("retired"):
                print(f"  #{rec['seq']:<3} {rec.get('task')} {rec.get('class')} RETIRED")
                continue
            sup = f"  (supersedes #{rec['supersedes']})" if rec.get("supersedes") else ""
            print(f"  #{rec['seq']:<3} {rec.get('task')} {rec.get('class')} "
                  f"-> {rec.get('outcome')}{sup}")
            print(f"       {rec.get('because')}")
    return 0


def show_invariants(plan: Plan, recapture=False):
    """A silent config is indistinguishable from a working one unless something
    can print it. Same reason `smokin rulings` exists."""
    iset = plan.invariants
    print(f"plan:   {plan.root}")
    print(f"source: {iset.source or '(none — no plan-level invariants; only per-task gates)'}")
    if iset.error:
        print(f"\nERROR:  {iset.error}")
        print("        Nothing is dispatched in this plan until it is fixed. This is")
        print("        deliberate: falling back to 'no invariants' would let a typo turn the")
        print("        blast-radius check off while the plan still looked guarded.")
        return 1
    if not iset.active:
        return 0

    print(f"declared: {len(iset.invariants)}   (each one runs at every tick boundary)")
    for inv in iset.invariants:
        expect = {"unchanged": "the reading must not move from the baseline",
                  "equals": f"the reading must equal {inv['expect']!r}",
                  "matches": f"the reading must match /{inv['expect']}/"}[inv["mode"]]
        print(f"  {inv['name']}")
        print(f"      run       {inv['run']}")
        print(f"      expect    {expect}   ({inv['budget_s']}s)")
        print(f"      because   {inv['because']}")

    if recapture:
        rows, why = invariant_pass(plan, recapture=True)
        if why:
            print(f"\nthe baseline could NOT be taken:\n  {why}")
            return 1
        print(f"\nbaseline recaptured for run {plan.run_id()} — {len(rows)} reading(s). "
              f"Everything from here is compared to the world as it is right now.")
        return 0

    base = I.read_baseline(plan.priv)
    if not base:
        print("\nbaseline: NOT TAKEN. The first `smokin tick` or `smokin verify` of this run "
              "takes it.\n          Take it BEFORE the change, not after — a baseline captured "
              "late records\n          the damage as normal and every later reading agrees with it.")
        return 0
    print(f"\nbaseline: {len(base.get('readings') or {})} reading(s) taken {base.get('at')} "
          f"for run {base.get('run')}")
    for name, r in sorted((base.get("readings") or {}).items()):
        print(f"  {name}")
        print(f"      {I.fmt_reading(r)}")
    return 0


def resume(plan: Plan):
    h = halted(plan)
    if not h:
        print("not halted — nothing to clear")
        return 0
    ledger(plan, event="resume", cleared_tier=h.get("tier"), was=h.get("why"))
    (plan.priv / "HALT.json").unlink(missing_ok=True)
    print(f"cleared a tier-{h['tier']} halt from {h['at']}:")
    print(f"  {h['why']}")
    print("\nThe halt is in .smokin/ledger.jsonl. Whatever caused it is not fixed by this.")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("cmd", choices=["doctor", "tick", "verify", "run", "status", "present",
                                    "reap", "reset", "rulings", "invariants", "resume",
                                    "memory", "remember", "wait"])
    ap.add_argument("plan", nargs="?", default=".")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--close", action="store_true",
                    help="closes the TAB of each task the reaper had to give up on "
                         "(SIGHUP). Not tasks that finished — their tab is what pane "
                         "reuse returns to")
    ap.add_argument("--run", default=None)
    ap.add_argument("--task", default=None, help="verify: gate one task instead of all")
    ap.add_argument("--recapture", action="store_true",
                    help="invariants: take a new baseline. Deliberate, and it goes in the ledger")
    # `remember`. `--task` is shared with `verify` on purpose — it means the same
    # thing in both places, which is the whole reason a provenance field is
    # allowed to be reused rather than renamed.
    ap.add_argument("--agent", default=None, help="remember: the persona this is about")
    ap.add_argument("--claim", default=None, help="remember: one line, what was learned")
    ap.add_argument("--observation", default=None,
                    help="remember: what was actually seen. Required")
    ap.add_argument("--command", default=None,
                    help="remember: the command that produced it. Required — an entry "
                         "nobody can re-run is not stored")
    ap.add_argument("--kind", default="lesson", choices=["fact", "lesson"],
                    help="remember: 'fact' (observed) or 'lesson' (generalised)")
    ap.add_argument("--timeout", type=float, default=0.0,
                    help="wait: give up after N seconds and exit 3. 0 = no limit")
    ap.add_argument("--max-wait", type=float, default=0.0,
                    help=f"run: longest a single wait between ticks may block "
                         f"(default {MAX_WAIT_S:g}s). A tick must still happen on "
                         f"its own to reap work whose worker died silently")
    ap.add_argument("--no-wait", action="store_true",
                    help="run: exit 5 when a person is needed instead of holding "
                         "for them. For cron and CI, where nobody is coming")
    ap.add_argument("--max-ticks", type=int, default=200)
    ap.add_argument("--interval", type=float, default=3.0)
    ap.add_argument("--version", action="version",
                    version=f"smokin {__version__} ({_ver()})")
    # INTERMIXED, because `smokin tick --close myplan` is a documented form and
    # plain `parse_args` REFUSED it: argparse takes positionals in contiguous
    # chunks, so `tick` filled `cmd`, `plan` defaulted to `.` unseen, and the
    # real path arrived after a flag as an "unrecognized argument". Every usage
    # line in this file that shows a flag puts it before the plan. Found by the
    # continuity tests, present since v1.0.0.
    a = ap.parse_intermixed_args()

    root = Path(a.plan).resolve()
    # `smokin verify path/to/TASK.md` — point it straight at the file. The task
    # folder is its parent, and that folder becomes the root.
    if root.is_file() and root.name == "TASK.md":
        root = root.parent
    if not (root / "tasks").is_dir() and not (root / "TASK.md").is_file():
        print(f"smokin: {root} has neither tasks/ nor a TASK.md — nothing to work with",
              file=sys.stderr)
        return 2
    plan = Plan(root)

    # A lone task can be CHECKED but not RUN. Dispatching out of a directory with
    # no plan around it is how you get a fleet nobody can resume — the thing the
    # plan directory exists to prevent. Say which commands apply rather than
    # failing with a stack trace or, worse, quietly doing it.
    READ_ONLY = {"verify", "doctor", "status", "present", "invariants", "memory"}
    if getattr(plan, "single", False) and a.cmd not in READ_ONLY:
        print(f"smokin: {root} is a single task, not a plan — `{a.cmd}` needs a plan "
              f"directory with tasks/. Available here: {', '.join(sorted(READ_ONLY))}.",
              file=sys.stderr)
        return 2

    if a.cmd == "doctor":
        return doctor(plan)
    if a.cmd == "reset":
        return reset(plan, a.run)
    if a.cmd == "rulings":
        return show_rulings(plan)
    if a.cmd == "memory":
        return show_memory(plan)
    if a.cmd == "remember":
        return remember(plan, a)
    if a.cmd == "invariants":
        return show_invariants(plan, a.recapture)
    if a.cmd == "resume":
        return resume(plan)
    if a.cmd == "reap":
        got = reap(plan, a.close)
        print(f"reaped {len(got)}: {', '.join(got) or '—'}")
        return 0
    if a.cmd in ("status", "present"):
        st = render_status(plan, [], [], [], [], (), halted(plan))
        write_progress(plan, st)
        if a.cmd == "present":
            print((root / "PROGRESS.md").read_text())
            return 0
        c = st["counts"]
        inflight_n = (c.get("running", 0) + c.get("claimed", 0) + c.get("judging", 0))
        rest = ("IN FLIGHT — do not update" if inflight_n else "at rest — safe to update")
        print(f"{c.get('verified',0)}/{st['total']} verified · "
              f"frontier: {', '.join(st['frontier']) or '—'} · {rest}")
        # THE EXIT CODE IS THE ANSWER, and for two years it was not there.
        # CHANGELOG's update policy says "smokin status <plan> — 0 = complete,
        # 3 = stuck. Either is safe to update on. Exit 1 means work is in
        # flight." That policy exists to stop the one upgrade that can lose
        # work — swapping the binary under a running tick — and `status`
        # returned 0 unconditionally, so anybody who followed it got a green
        # light over a live fleet. Found by following our own instructions
        # while upgrading a box with six real plans on it.
        #
        # Same ladder as `tick`, read from the same STATUS.json, so the two can
        # never disagree: 0 complete · 1 in flight · 3 stuck · 4 halted ·
        # 5 waiting on a person. It still starts nothing and asks nobody.
        #
        #   1 is the ONLY code that means "do not upgrade". Everything else is
        #   a plan at rest, whatever the reason.
        if halted(plan):
            return 4
        inflight = (c.get("running", 0) + c.get("claimed", 0) + c.get("judging", 0))
        if inflight:
            return 1
        if plan.tasks and c.get("verified", 0) == len(plan.tasks):
            return 0
        # NOTHING IS RUNNING FROM HERE DOWN, so every code below is safe to
        # update on. The distinction is what the operator does NEXT, and the
        # one that matters is that READY-BUT-NOT-STARTED is not "in flight":
        # a first draft of this returned 1 there, which is the same false alarm
        # in the other direction — it would refuse a safe upgrade on four of the
        # six plans this was found on.
        waiting = [t["id"] for t in st["tasks"] if t.get("needs_human")
                   and t.get("state") != "verified"]
        ready = [t for t in st["frontier"] if t not in waiting]
        if waiting and not ready:
            return 5
        return 3
    if a.cmd == "wait":
        return wait(plan, a.task, a.timeout, max(a.interval, 0.05))
    if a.cmd == "verify":
        return verify(plan, a.task)
    if a.cmd == "tick":
        return tick(plan, a.dry_run, a.close)
    if a.cmd == "run":
        waited = False
        # THE LOOP STOPS ON EVERY TERMINAL READING, and 4 was missing from that
        # list. A halt is the tick saying a machine is broken and refusing to add
        # work on top of it — and `run` was sleeping three seconds and asking
        # again, forever, which is the exact opposite of what a halt is for. It
        # would have re-ticked a tier-1 invariant breach 200 times.
        #   0  complete      3  stuck         4  halted
        #   5  waiting on a person            1  in flight, keep going
        for i in range(a.max_ticks):
            rc = tick(plan, a.dry_run, a.close)
            # 5 IS NOT A REASON TO STOP. A person is not a failure and not the
            # end of the work — they are the answer to a question the plan could
            # not settle by itself. Exiting here made the operator the scheduler:
            # they had to notice, act, and remember to re-run. So the loop holds
            # the branch open and keeps watching the plan directory; the moment
            # an ANSWER.md lands, or a status moves, the next tick picks it up
            # and carries on. `--no-wait` restores the old behaviour for a cron
            # job or a CI step, where nobody is coming.
            if rc == 5 and not a.no_wait:
                if not waited:
                    print("\nholding — this loop does not end because a person is "
                          "needed. Answer when you are back; it continues by itself.")
                    waited = True
                # ONLY RE-TICK WHEN THE PLAN ACTUALLY MOVED. A wait that
                # times out means nothing changed, and ticking again would
                # reprint the whole "waiting on a person" banner every few
                # seconds for as long as somebody is away — turning a held
                # branch into log spam that buries the one line they need to
                # read. Nothing is in flight in this state by definition, so
                # there is no worker to reap and nothing a bare tick would
                # learn. A halt is the exception: it outranks the wait.
                while True:
                    w = wait(plan, timeout=(a.max_wait or MAX_WAIT_S),
                             poll=max(a.interval, 0.05), quiet=True)
                    if w == 4:
                        return tick(plan, a.dry_run, a.close)
                    if w == 0:
                        break
                plan = Plan(root)
                continue
            if rc != 1:
                return rc
            # WATCH, DO NOT NAP. A fixed sleep is both too slow (a task that
            # finished in the first 200ms waits out the rest of the interval)
            # and too fast (a long task is re-ticked hundreds of times for
            # nothing). `wait` returns the moment a file moves, and `--interval`
            # becomes the poll granularity it uses rather than a blind delay.
            # CAPPED, ALWAYS. A wait with no ceiling turns `run` into something
            # that can block forever: a worker that dies without emitting moves
            # no file, so nothing wakes the waiter, and the tick that would have
            # REAPED it on budget never happens. The wait is an optimisation over
            # the old blind sleep, never a gate on the loop.
            wait(plan, timeout=(a.max_wait or MAX_WAIT_S),
                 poll=max(a.interval, 0.05), quiet=True)
            plan = Plan(root)
        print("max ticks reached")
        return 1
    return 2


if __name__ == "__main__":
    sys.exit(main())
